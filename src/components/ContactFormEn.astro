---
// Englische Version von ContactForm.astro – identische Feldnamen (name=...)
// für konsistente Formspree-Auswertung, nur die sichtbaren Texte sind
// übersetzt. Nutzt dieselbe Versand-Logik, siehe src/lib/formSubmit.ts.
import { site } from "../config/site";

interface Props {
  services: string[];
  presetService?: string;
}

const { services, presetService } = Astro.props;
---

<div class="reveal" data-inline-form-wrap>
<form
  class="card grid gap-5 p-6 sm:p-8"
  action={site.formEndpoint}
  method="POST"
  id="quote-form"
  data-inline-form
  novalidate
>
  <!-- Honeypot -->
  <div class="hidden" aria-hidden="true">
    <label for="quote-website">Leave this field empty</label>
    <input type="text" id="quote-website" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_subject" value="New enquiry via the English contact form – wa-clean.de" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label for="en-name" class="mb-1.5 block text-sm font-medium text-brand-900">Name / Company *</label>
      <input
        type="text"
        id="en-name"
        name="name"
        required
        autocomplete="name"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="Your name or company name"
      />
    </div>

    <div>
      <label for="en-telefon" class="mb-1.5 block text-sm font-medium text-brand-900">Phone number *</label>
      <input
        type="tel"
        id="en-telefon"
        name="telefon"
        required
        autocomplete="tel"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="Your phone number"
      />
    </div>

    <div>
      <label for="en-email" class="mb-1.5 block text-sm font-medium text-brand-900">Email *</label>
      <input
        type="email"
        id="en-email"
        name="email"
        required
        autocomplete="email"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="your@email.com"
      />
    </div>

    <div>
      <label for="en-leistung" class="mb-1.5 block text-sm font-medium text-brand-900">Service needed</label>
      <select
        id="en-leistung"
        name="leistung"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600"
      >
        <option value="">Please choose (optional)</option>
        {services.map((s) => (
          <option value={s} selected={s === presetService}>{s}</option>
        ))}
        <option value="Other">Other / not sure</option>
      </select>
    </div>

    <div>
      <label for="en-ort" class="mb-1.5 block text-sm font-medium text-brand-900">Location / postcode *</label>
      <input
        type="text"
        id="en-ort"
        name="ort"
        required
        autocomplete="postal-code"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="e.g. 65375 Oestrich-Winkel"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="en-nachricht" class="mb-1.5 block text-sm font-medium text-brand-900">Message</label>
      <textarea
        id="en-nachricht"
        name="nachricht"
        rows="4"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="A short description of your request (optional)"
      ></textarea>
    </div>
  </div>

  <label class="flex items-start gap-3 text-sm text-brand-900/80">
    <input
      type="checkbox"
      name="datenschutz"
      required
      class="mt-1 h-4 w-4 rounded border-brand-950/20 text-accent-600 focus:ring-accent-600"
    />
    <span>
      I have read the <a href="/datenschutz/" class="underline hover:text-accent-600">privacy policy</a> and
      agree to my data being processed to handle my enquiry. *
    </span>
  </label>

  <button type="submit" class="btn-primary w-full sm:w-auto">
    Request a free, no-obligation quote
  </button>

  <p class="text-xs text-brand-900/50">
    Alternatively, reach us by phone at {site.phoneDisplay} or by email at {site.email}.
  </p>
</form>

<div class="card p-6 text-center sm:p-8" data-inline-form-success hidden>
  <p class="text-lg font-semibold text-brand-950">Thank you for your enquiry!</p>
  <p class="mt-2 text-sm text-brand-700">
    We've received your details and will get back to you as soon as possible with a no-obligation quote.
  </p>
</div>
</div>

<script>
  import { setupInlineForm } from "../lib/formSubmit";

  document.querySelectorAll<HTMLElement>("[data-inline-form-wrap]").forEach((wrap) => {
    const form = wrap.querySelector<HTMLFormElement>("[data-inline-form]");
    const successBox = wrap.querySelector<HTMLElement>("[data-inline-form-success]");
    if (form) setupInlineForm(form, successBox);
  });
</script>
