---
// Interaktiver Vorher-/Nachher-Regler: Maus (oder Finger) über das Bild
// bewegen, um live zwischen schmutzigem und sauberem Zustand zu wischen.
interface Props {
  before: string;
  after: string;
  alt: string;
  class?: string;
}

const { before, after, alt, class: className = "" } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<div
  class:list={["ba-slider relative select-none overflow-hidden rounded-lg", className]}
  data-ba-slider={uid}
>
  <img src={before} alt={`${alt} – schmutzig`} class="pointer-events-none absolute inset-0 h-full w-full object-cover" draggable="false" />
  <img
    src={after}
    alt={`${alt} – sauber`}
    class="ba-after pointer-events-none absolute inset-0 h-full w-full object-cover"
    style="clip-path: inset(0 45% 0 0);"
    draggable="false"
  />

  <div class="ba-handle pointer-events-none absolute inset-y-0 flex w-0 items-center justify-center" style="left: 55%;">
    <div class="absolute inset-y-0 w-0.5 bg-white/90 shadow-[0_0_6px_rgba(0,0,0,0.4)]"></div>
    <div class="relative flex h-9 w-9 items-center justify-center rounded-full bg-white shadow-lg">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1d1d1f" stroke-width="2" stroke-linecap="round">
        <path d="M8 7L4 12L8 17" /><path d="M16 7L20 12L16 17" />
      </svg>
    </div>
  </div>

  <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-brand-950/70 px-2.5 py-1 text-xs font-medium text-white">
    Vorher
  </span>
  <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-accent-600/90 px-2.5 py-1 text-xs font-medium text-white">
    Nachher
  </span>
</div>

<script>
  function initBaSliders(root: ParentNode) {
    root.querySelectorAll<HTMLElement>(".ba-slider").forEach((el) => {
      if (el.dataset.baInit) return;
      el.dataset.baInit = "1";

      const afterImg = el.querySelector<HTMLElement>(".ba-after");
      const handle = el.querySelector<HTMLElement>(".ba-handle");
      if (!afterImg || !handle) return;

      const setPosition = (clientX: number) => {
        const rect = el.getBoundingClientRect();
        const percent = Math.min(100, Math.max(0, ((clientX - rect.left) / rect.width) * 100));
        afterImg.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
        handle.style.left = `${percent}%`;
      };

      el.addEventListener("pointermove", (e) => setPosition((e as PointerEvent).clientX));
      el.addEventListener(
        "touchmove",
        (e) => {
          const touch = (e as TouchEvent).touches[0];
          if (touch) setPosition(touch.clientX);
        },
        { passive: true }
      );
    });
  }

  initBaSliders(document);
</script>
