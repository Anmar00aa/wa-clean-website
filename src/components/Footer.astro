---
import { site, footerNav, footerNavEn, regions, locations } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const year = new Date().getFullYear();

const legalNav = lang === "en" ? footerNavEn.legal : footerNav.rechtliches;
const companyNav = lang === "en" ? footerNavEn.company : footerNav.unternehmen;
const servicesNav = lang === "en" ? footerNavEn.services : footerNav.leistungen;

const t = lang === "en"
  ? {
      tagline: `Professional building cleaning for businesses and private clients in Wiesbaden, the ${regions[0]} and Mainz.`,
      company: "Company",
      services: "Services",
      contact: "Contact",
      tel: "Tel.",
      mobile: "Mobile",
      email: "Email",
      rights: "All rights reserved.",
      mainOffice: "Head Office",
      rheingauOffice: "Rheingau Location",
      mainzOffice: "Mainz Location",
      soon: "coming soon",
    }
  : {
      tagline: `Professionelle Gebäudereinigung für Unternehmen und Privatkunden in Wiesbaden, im ${regions[0]} und in Mainz.`,
      company: "Unternehmen",
      services: "Leistungen",
      contact: "Kontakt",
      tel: "Tel.",
      mobile: "Mobil",
      email: "E-Mail",
      rights: "Alle Rechte vorbehalten.",
      mainOffice: "Hauptniederlassung",
      rheingauOffice: "Standort Rheingau",
      mainzOffice: "Standort Mainz",
      soon: "demnächst",
    };
---

<footer class="bg-brand-950 text-brand-50 pb-24 lg:pb-0">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:py-16">
    <div>
      <img src="/logo-horizontal-weiss.png" alt={site.name} class="h-14 w-auto" width="1142" height="400" loading="lazy" />
      <p class="mt-4 text-sm leading-relaxed text-brand-100/80">
        {t.tagline}
      </p>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-white/90">{t.company}</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-brand-100/80">
        {companyNav.map((item) => (
          <li><a href={item.href} class="hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-white/90">{t.services}</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-brand-100/80">
        {servicesNav.map((item) => (
          <li><a href={item.href} class="hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-white/90">{t.contact}</h3>
      <ul class="mt-4 space-y-4 text-sm text-brand-100/80">
        {locations.map((loc) => (
          <li>
            <div class="flex items-start gap-2">
              <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0" />
              <span>
                <a href={loc.isMain ? "/gebaeudereinigung-wiesbaden/" : "/gebaeudereinigung-rheingau/"} class="hover:text-white">
                  {loc.isMain ? t.mainOffice : t.rheingauOffice}
                </a>: {loc.street}, {loc.zip} {loc.city}
              </span>
            </div>
            <div class="mt-1.5 flex items-center gap-2">
              <Icon name="phone" class="h-4 w-4 shrink-0" />
              <span>{t.tel}: <a href={loc.phoneHref} class="hover:text-white">{loc.phoneDisplay}</a></span>
            </div>
            <div class="mt-1 flex items-center gap-2">
              <Icon name="phone" class="h-4 w-4 shrink-0" />
              <span>{t.mobile}: <a href={loc.mobileHref} class="hover:text-white">{loc.mobileDisplay}</a></span>
            </div>
          </li>
        ))}
        <li class="flex items-center gap-2">
          <Icon name="map-pin" class="h-4 w-4 shrink-0" />
          <span>
            <a href={lang === "en" ? "/en/mainz/" : "/gebaeudereinigung-mainz/"} class="hover:text-white">{t.mainzOffice}</a>
            <span class="ml-1 rounded-full bg-[#95c234]/20 px-2 py-0.5 text-[0.7rem] font-semibold text-[#c8e88a]">{t.soon}</span>
          </span>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="mail" class="h-4 w-4 shrink-0" />
          <span>{t.email}: <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-brand-100/70 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. {t.rights}</p>
      <div class="flex gap-5">
        {legalNav.map((item) => (
          <a href={item.href} class="hover:text-white">{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
