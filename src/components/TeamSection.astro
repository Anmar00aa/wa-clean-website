---
// Geschäftsführung mit Foto, Rolle und Direktkontakt je Standort.
import { managers } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const isEn = lang === "en";

const t = isEn
  ? {
      eyebrow: "Management",
      heading: "Your contacts at WA-Clean",
      text: "No call centre, no anonymous hotline: you speak directly with the people who run the company.",
      call: "Call",
    }
  : {
      eyebrow: "Geschäftsführung",
      heading: "Ihre Ansprechpartner bei WA-Clean",
      text: "Kein Callcenter, keine anonyme Hotline: Sie sprechen direkt mit den Menschen, die das Unternehmen führen.",
      call: "Anrufen",
    };
---

<section class="py-14 sm:py-16">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.heading}</h2>
      <p class="mt-4 text-brand-700">{t.text}</p>
    </div>

    <div class="reveal-group mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-2">
      {managers.map((m) => (
        <article class="reveal-item card overflow-hidden">
          <div class="aspect-[4/5] overflow-hidden bg-[#0b0b0b]">
            <img
              src={m.photo}
              alt={`${m.name}, ${isEn ? m.roleEn : m.roleDe}`}
              width={m.width}
              height={m.height}
              loading="lazy"
              class="h-full w-full object-cover object-top"
            />
          </div>
          <div class="p-5">
            <h3 class="text-lg font-semibold">{m.name}</h3>
            <p class="mt-0.5 text-sm text-brand-700">{isEn ? m.roleEn : m.roleDe}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={m.location.phoneHref} class="btn-secondary !px-4 !py-2 text-sm">
                <Icon name="phone" class="h-4 w-4" />
                {t.call}
              </a>
              <a href={m.location.mobileHref} class="btn-secondary !px-4 !py-2 text-sm">
                <Icon name="phone" class="h-4 w-4" />
                {m.location.mobileDisplay}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
