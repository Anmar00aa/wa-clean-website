---
// "Vorher. Nachher. WA-Clean." – interaktiver Vorher-/Nachher-Bereich mit
// ausschließlich echten WA-Clean-Projektfotos (siehe public/work/). Nutzt
// die bestehende BeforeAfterSlider-Komponente (Maus-Hover auf Desktop,
// Touch-Wischen auf Mobile).
import BeforeAfterSlider from "./BeforeAfterSlider.astro";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;

const paareDe = [
  { titel: "Fensterreinigung", before: "/work/fenster-spinnweben-vorher.jpg", after: "/work/fenster-spinnweben-nachher.jpg", alt: "Fensterreinigung – Spinnweben entfernt" },
  { titel: "Sanitärreinigung", before: "/work/waschbecken-einzeln-vorher.jpg", after: "/work/waschbecken-einzeln-nachher.jpg", alt: "Sanitärreinigung – Waschbecken" },
];
const paareEn = [
  { titel: "Window cleaning", before: "/work/fenster-spinnweben-vorher.jpg", after: "/work/fenster-spinnweben-nachher.jpg", alt: "Window cleaning – cobwebs removed" },
  { titel: "Bathroom cleaning", before: "/work/waschbecken-einzeln-vorher.jpg", after: "/work/waschbecken-einzeln-nachher.jpg", alt: "Bathroom cleaning – washbasin" },
];
const paare = lang === "en" ? paareEn : paareDe;

const t = lang === "en"
  ? {
      eyebrow: "Results",
      heading: "Before. After. WA-Clean.",
      text: "Move the slider to see the difference instantly – real photos from our projects.",
      cta: "See more references",
      href: "/en/references/",
    }
  : {
      eyebrow: "Ergebnisse",
      heading: "Vorher. Nachher. WA-Clean.",
      text: "Bewegen Sie den Regler, um den Unterschied direkt zu sehen – echte Fotos aus unseren Projekten.",
      cta: "Weitere Referenzen ansehen",
      href: "/referenzen/",
    };
---

<section class="bg-warm-50 py-16 sm:py-20 lg:py-24">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t.heading}</h2>
      <p class="mt-4 text-brand-700">
        {t.text}
      </p>
    </div>

    <div class="reveal-group mt-12 grid gap-6 sm:grid-cols-2">
      {paare.map((p) => (
        <div class="reveal-item">
          <BeforeAfterSlider before={p.before} after={p.after} alt={p.alt} class="aspect-[4/3] w-full" />
          <p class="mt-3 text-center text-sm font-medium text-brand-700">{p.titel}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href={t.href} class="btn-secondary">
        {t.cta}
      </a>
    </div>
  </div>
</section>
