---
// Formular "Kostenlose Objektbesichtigung anfragen".
import { site } from "../config/site";

interface Props {
  services: string[];
}

const { services } = Astro.props;
---

<div class="card p-6 sm:p-8" data-inline-form-wrap>
  <form class="grid gap-4 sm:grid-cols-2" action={site.formEndpoint} method="POST" data-inline-form novalidate>
    <div class="hidden sm:col-span-2" aria-hidden="true">
      <label for="besichtigung-website">Bitte freilassen</label>
      <input type="text" id="besichtigung-website" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="_subject" value="Neue Besichtigungsanfrage – wa-clean.de" />

    <div>
      <label for="besichtigung-name" class="mb-1.5 block text-sm font-medium text-brand-900">Name *</label>
      <input type="text" id="besichtigung-name" name="name" required autocomplete="name" class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600" />
    </div>
    <div>
      <label for="besichtigung-firma" class="mb-1.5 block text-sm font-medium text-brand-900">Firma</label>
      <input type="text" id="besichtigung-firma" name="firma" autocomplete="organization" class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600" />
    </div>
    <div>
      <label for="besichtigung-telefon" class="mb-1.5 block text-sm font-medium text-brand-900">Telefonnummer *</label>
      <input type="tel" id="besichtigung-telefon" name="telefon" required autocomplete="tel" class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600" />
    </div>
    <div>
      <label for="besichtigung-email" class="mb-1.5 block text-sm font-medium text-brand-900">E-Mail *</label>
      <input type="email" id="besichtigung-email" name="email" required autocomplete="email" class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600" />
    </div>
    <div>
      <label for="besichtigung-ort" class="mb-1.5 block text-sm font-medium text-brand-900">Ort *</label>
      <input type="text" id="besichtigung-ort" name="ort" required class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600" />
    </div>
    <div>
      <label for="besichtigung-leistung" class="mb-1.5 block text-sm font-medium text-brand-900">Gewünschte Leistung</label>
      <select id="besichtigung-leistung" name="leistung" class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600">
        <option value="">Bitte wählen (optional)</option>
        {services.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>
    <div class="sm:col-span-2">
      <label for="besichtigung-termin" class="mb-1.5 block text-sm font-medium text-brand-900">Bevorzugter Termin</label>
      <input type="text" id="besichtigung-termin" name="termin" placeholder="z. B. nächste Woche vormittags" class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600" />
    </div>

    <label class="flex items-start gap-2.5 text-xs text-brand-900/70 sm:col-span-2">
      <input type="checkbox" name="datenschutz" required class="mt-0.5 h-3.5 w-3.5 rounded border-brand-950/20 text-accent-600 focus:ring-accent-600" />
      <span>Ich stimme der <a href="/datenschutz/" class="underline hover:text-accent-600">Datenschutzerklärung</a> zu. *</span>
    </label>

    <button type="submit" class="btn-primary w-full sm:col-span-2 sm:w-auto">Besichtigung vereinbaren</button>
  </form>

  <div class="p-2 text-center" data-inline-form-success hidden>
    <p class="text-base font-semibold text-brand-950">Vielen Dank für Ihre Anfrage!</p>
    <p class="mt-1.5 text-sm text-brand-700">Wir melden uns zur Terminabstimmung bei Ihnen.</p>
  </div>
</div>

<script>
  import { setupInlineForm } from "../lib/formSubmit";
  document.querySelectorAll<HTMLElement>("[data-inline-form-wrap]").forEach((wrap) => {
    const form = wrap.querySelector<HTMLFormElement>("[data-inline-form]");
    const successBox = wrap.querySelector<HTMLElement>("[data-inline-form-success]");
    if (form) setupInlineForm(form, successBox);
  });
</script>
