---
// Zugängliches Akkordeon auf Basis von <details>/<summary> – funktioniert
// vollständig ohne JavaScript, Öffnen/Schließen kommt nativ vom Browser.
import Icon from "./Icon.astro";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="reveal-group divide-y divide-brand-950/[0.08] overflow-hidden rounded-lg ring-1 ring-brand-950/[0.08]">
  {items.map((item) => (
    <details class="reveal-item group bg-white open:bg-brand-50/40">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[0.975rem] font-medium text-brand-950 marker:content-none sm:px-6 sm:py-5">
        {item.question}
        <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-brand-500 transition-transform duration-200 group-open:rotate-180 group-open:text-accent-600" />
      </summary>
      <div class="px-5 pb-5 text-sm leading-relaxed text-brand-700 sm:px-6 sm:pb-6">
        {item.answer}
      </div>
    </details>
  ))}
</div>
