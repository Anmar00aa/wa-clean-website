---
// Bereich speziell für Geschäftskunden.
import Icon from "./Icon.astro";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;

const zielgruppenDe = [
  "Büros", "Hausverwaltungen", "Praxen", "Hotels", "Gastronomie",
  "Kitas & Schulen", "Treppenhäuser", "Gewerbeobjekte", "Mehrfamilienhäuser",
];
const zielgruppenEn = [
  "Offices", "Property managers", "Practices", "Hotels", "Restaurants",
  "Childcare & schools", "Stairwells", "Commercial properties", "Apartment buildings",
];
const zielgruppen = lang === "en" ? zielgruppenEn : zielgruppenDe;

const t = lang === "en"
  ? {
      eyebrow: "For businesses",
      heading: "Cleaning solutions for businesses & property managers",
      text: "From regular routine cleaning to managing multiple properties: WA-Clean develops cleaning solutions tailored to your building, your operations and your requirements.",
      cta1: "Get a custom quote for your property",
      cta2: "Request a free site visit",
      suitableFor: "Suitable for",
      ctaHref: "/en/contact/",
    }
  : {
      eyebrow: "Für Unternehmen",
      heading: "Reinigungslösungen für Unternehmen & Hausverwaltungen",
      text: "Von regelmäßiger Unterhaltsreinigung bis zur Betreuung mehrerer Objekte: WA-Clean entwickelt Reinigungslösungen passend zu Ihrem Gebäude, Ihren Abläufen und Ihren Anforderungen.",
      cta1: "Individuelles Angebot für Ihr Objekt",
      cta2: "Kostenlose Besichtigung anfragen",
      suitableFor: "Geeignet für",
      ctaHref: "/kontakt/",
    };
---

<section class="bg-brand-950 py-16 sm:py-20 lg:py-24">
  <div class="container-page grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
    <div class="reveal">
      <p class="eyebrow text-accent-400">{t.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">
        {t.heading}
      </h2>
      <p class="mt-4 text-brand-100/80 leading-relaxed">
        {t.text}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={t.ctaHref} class="btn-primary">{t.cta1}</a>
        <a href={`${t.ctaHref}${lang === "en" ? "" : "#besichtigung"}`} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
          {t.cta2}
        </a>
      </div>
    </div>

    <div class="reveal card bg-white p-6 sm:p-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">{t.suitableFor}</p>
      <ul class="mt-4 grid grid-cols-2 gap-3">
        {zielgruppen.map((z) => (
          <li class="flex items-center gap-2 text-sm text-brand-900">
            <Icon name="check" class="h-4 w-4 shrink-0 text-accent-600" />
            {z}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
