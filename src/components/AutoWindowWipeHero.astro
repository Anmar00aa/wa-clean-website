---
// Automatisch ablaufende, hochwertige Fensterreinigungs-Animation für den
// Hero-Hintergrund. Ersetzt die frühere maus-gesteuerte Variante
// (GlassWipeHero.astro, bleibt unbenutzt im Projekt erhalten): hier bewegt
// sich ein Fensterwischer/Abzieher komplett automatisch, langsam und ohne
// Maus-/Touch-Interaktion über die Fläche und zieht dabei eine klare Grenze
// zwischen leicht beschlagener und sauberer Fläche.
//
// Zwei Canvas-Layer: fog-canvas (persistent, Beschlag wird per
// destination-out dauerhaft "abgezogen") + tool-canvas (wird jeden Frame
// neu gezeichnet, damit der Wischer keine Spur aus Kopien hinterlässt).
//
// HINWEIS zu "fotorealistischen" Werkzeug-Assets: Wie beim vorherigen Hero-
// Effekt gibt es kein Bildgenerierungs-Tool in dieser Umgebung. Die
// Gummilippe/der Abzieher ist daher weiterhin eine handgezeichnete
// Vektorform im Canvas (Farbverläufe, Schattierung), keine Fotomontage.
// Für einen noch realistischeren Eindruck würde sich ein transparentes
// PNG/WebP-Sprite eines echten Fensterwischers (Draufsicht, freigestellt)
// eignen, das hier per Rotation/Translation eingesetzt werden könnte.
interface Props {
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
---

<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" data-auto-wipe-root>
  <img src={image} alt={alt} class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-brand-950/55"></div>
  <canvas class="absolute inset-0 h-full w-full" data-fog-canvas></canvas>
  <canvas class="absolute inset-0 h-full w-full" data-tool-canvas></canvas>
</div>

<script>
  interface Point {
    x: number;
    y: number;
  }

  function setupAutoWipe(root: HTMLElement) {
    const fogCanvas = root.querySelector<HTMLCanvasElement>("[data-fog-canvas]");
    const toolCanvas = root.querySelector<HTMLCanvasElement>("[data-tool-canvas]");
    const fctx = fogCanvas?.getContext("2d");
    const tctx = toolCanvas?.getContext("2d");
    if (!fogCanvas || !toolCanvas || !fctx || !tctx) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) return; // Statischer Zustand: nur Bild + Tint, siehe Markup.

    const isMobile = window.matchMedia("(max-width: 640px)").matches;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2);
    let toolWidth = 90;

    function paintFog() {
      fctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      fctx!.clearRect(0, 0, width, height);
      fctx!.globalCompositeOperation = "source-over";

      // Sehr dezente Feuchtigkeit/Beschlag statt starker Verschmutzung
      fctx!.fillStyle = "rgba(235,240,244,0.16)";
      fctx!.fillRect(0, 0, width, height);

      const streakCount = isMobile ? 5 : 10;
      for (let i = 0; i < streakCount; i++) {
        const x = Math.random() * width;
        const y = Math.random() * height;
        const len = Math.random() * 140 + 70;
        const angle = Math.random() * Math.PI;
        const grad = fctx!.createLinearGradient(x, y, x + Math.cos(angle) * len, y + Math.sin(angle) * len);
        grad.addColorStop(0, "rgba(255,255,255,0)");
        grad.addColorStop(0.5, "rgba(255,255,255,0.06)");
        grad.addColorStop(1, "rgba(255,255,255,0)");
        fctx!.strokeStyle = grad;
        fctx!.lineWidth = Math.random() * 18 + 8;
        fctx!.beginPath();
        fctx!.moveTo(x, y);
        fctx!.lineTo(x + Math.cos(angle) * len, y + Math.sin(angle) * len);
        fctx!.stroke();
      }

      const spotCount = isMobile ? 2 : 4;
      for (let i = 0; i < spotCount; i++) {
        const x = Math.random() * width;
        const y = Math.random() * height;
        const r = Math.random() * 60 + 40;
        const g = fctx!.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, "rgba(255,255,255,0.05)");
        g.addColorStop(1, "rgba(255,255,255,0)");
        fctx!.fillStyle = g;
        fctx!.beginPath();
        fctx!.arc(x, y, r, 0, Math.PI * 2);
        fctx!.fill();
      }
    }

    let resizeTimer = 0;
    function resize() {
      const rect = root.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2);
      for (const c of [fogCanvas!, toolCanvas!]) {
        c.width = Math.round(width * dpr);
        c.height = Math.round(height * dpr);
      }
      toolWidth = Math.min(150, Math.max(70, height * (isMobile ? 0.16 : 0.22)));
      paintFog();
    }
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    }, { passive: true });

    function roundRect(c: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      c.beginPath();
      c.moveTo(x + r, y);
      c.arcTo(x + w, y, x + w, y + h, r);
      c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r);
      c.arcTo(x, y, x + w, y, r);
      c.closePath();
    }

    function drawSqueegee(x: number, y: number, angle: number) {
      const len = toolWidth * 0.62;
      const bladeLen = len * 0.66;
      tctx!.save();
      tctx!.translate(x, y);
      tctx!.rotate(angle);

      const handleGrad = tctx!.createLinearGradient(-len * 0.55, 0, -bladeLen * 0.5, 0);
      handleGrad.addColorStop(0, "#1d1d1f");
      handleGrad.addColorStop(1, "#4b4b4d");
      tctx!.fillStyle = handleGrad;
      roundRect(tctx!, -len * 0.55, -4, len * 0.55 - bladeLen * 0.5 + 6, 8, 4);
      tctx!.fill();

      tctx!.shadowColor = "rgba(0,0,0,0.35)";
      tctx!.shadowBlur = 8;
      tctx!.shadowOffsetY = 2;
      const barGrad = tctx!.createLinearGradient(0, -toolWidth * 0.5, 0, toolWidth * 0.5);
      barGrad.addColorStop(0, "#c9ced2");
      barGrad.addColorStop(0.5, "#eef1f3");
      barGrad.addColorStop(1, "#a9afb4");
      tctx!.fillStyle = barGrad;
      roundRect(tctx!, -bladeLen / 2, -toolWidth * 0.5, bladeLen, toolWidth * 0.22, 4);
      tctx!.fill();

      const bladeGrad = tctx!.createLinearGradient(0, -toolWidth * 0.28, 0, toolWidth * 0.5);
      bladeGrad.addColorStop(0, "#3a3a3c");
      bladeGrad.addColorStop(0.15, "#1d1d1f");
      bladeGrad.addColorStop(1, "#000000");
      tctx!.fillStyle = bladeGrad;
      roundRect(tctx!, -bladeLen / 2, -toolWidth * 0.28, bladeLen, toolWidth * 0.78, 6);
      tctx!.fill();
      tctx!.shadowColor = "transparent";

      tctx!.strokeStyle = "rgba(255,255,255,0.35)";
      tctx!.lineWidth = 1.5;
      tctx!.beginPath();
      tctx!.moveTo(-bladeLen / 2 + 4, toolWidth * 0.46);
      tctx!.lineTo(bladeLen / 2 - 4, toolWidth * 0.46);
      tctx!.stroke();

      tctx!.restore();
    }

    function wipeSegment(from: Point, to: Point) {
      fctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      fctx!.globalCompositeOperation = "destination-out";
      fctx!.lineCap = "round";
      fctx!.lineJoin = "round";

      fctx!.strokeStyle = "rgba(0,0,0,0.4)";
      fctx!.lineWidth = toolWidth * 1.3;
      fctx!.beginPath();
      fctx!.moveTo(from.x, from.y);
      fctx!.lineTo(to.x, to.y);
      fctx!.stroke();

      fctx!.strokeStyle = "rgba(0,0,0,1)";
      fctx!.lineWidth = toolWidth;
      fctx!.beginPath();
      fctx!.moveTo(from.x, from.y);
      fctx!.lineTo(to.x, to.y);
      fctx!.stroke();
    }

    // Ein ruhiger diagonaler Wischzug über einen guten Teil der Fläche.
    function getPath(): [Point, Point] {
      return [
        { x: width * 0.06, y: height * 0.66 },
        { x: width * 0.7, y: height * 0.26 },
      ];
    }

    const SWEEP_MS = isMobile ? 3400 : 4600;
    const PAUSE_MS = 1700;
    const WAIT_BEFORE_START_MS = 1200;

    type Phase = "sweeping" | "pausing" | "waiting";
    let phase: Phase = "waiting";
    let phaseStart = 0;
    let lastToolPos: Point | null = null;

    function easeInOutSine(t: number) {
      return -(Math.cos(Math.PI * t) - 1) / 2;
    }

    function clearToolLayer() {
      tctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      tctx!.clearRect(0, 0, width, height);
    }

    function frame(now: number) {
      if (phaseStart === 0) phaseStart = now;
      const elapsed = now - phaseStart;
      const [start, end] = getPath();
      const pathAngle = Math.atan2(end.y - start.y, end.x - start.x) + Math.PI / 2;

      clearToolLayer();

      if (phase === "waiting") {
        if (elapsed >= WAIT_BEFORE_START_MS) {
          phase = "sweeping";
          phaseStart = now;
        }
      } else if (phase === "sweeping") {
        const t = Math.min(1, elapsed / SWEEP_MS);
        const eased = easeInOutSine(t);
        const current: Point = {
          x: start.x + (end.x - start.x) * eased,
          y: start.y + (end.y - start.y) * eased,
        };

        if (lastToolPos) wipeSegment(lastToolPos, current);
        lastToolPos = current;
        drawSqueegee(current.x, current.y, pathAngle);

        if (t >= 1) {
          phase = "pausing";
          phaseStart = now;
        }
      } else if (phase === "pausing") {
        drawSqueegee(end.x, end.y, pathAngle);

        if (elapsed >= PAUSE_MS) {
          // Unauffälliger Reset: Die Scheibe beschlägt erneut, während das
          // Werkzeug kurz ruht (kein sichtbares "Springen" der Wischbewegung).
          paintFog();
          lastToolPos = null;
          phase = "waiting";
          phaseStart = now;
        }
      }

      requestAnimationFrame(frame);
    }

    resize();
    requestAnimationFrame(frame);
  }

  document.querySelectorAll<HTMLElement>("[data-auto-wipe-root]").forEach(setupAutoWipe);
</script>
