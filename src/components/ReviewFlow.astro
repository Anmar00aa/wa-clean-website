---
// Bewertungs-Flow: 5-Sterne-Auswahl -> je nach Ergebnis Dank+Google-Link
// ODER Entschuldigung+Feedback-Formular. WICHTIG: kein Review-Gating –
// der Google-Bewertungslink ist in JEDEM Pfad sichtbar und frei anklickbar,
// niemals versteckt oder von der Sternezahl abhängig gemacht.
//
// HINWEIS zum Versand: Wie beim bestehenden ContactForm.astro ist dieses
// Formular noch nicht an ein Backend angebunden (action="#"). Für eine
// statische Astro-Seite eignet sich z. B. Netlify Forms, Formspree oder
// eine eigene API-Route – dort sollte auch die serverseitige Prüfung des
// Honeypot-Felds sowie die Foto-Upload-Größe/-Typprüfung erfolgen.
import { site } from "../config/site";

interface Props {
  services: string[];
}

const { services } = Astro.props;
---

<div class="reveal" data-review-flow>
  <div class="flex justify-center">
    <fieldset class="star-rating" data-star-rating>
      <legend class="sr-only">Sternebewertung auswählen</legend>
      {[5, 4, 3, 2, 1].map((n) => (
        <>
          <input type="radio" id={`star-${n}`} name="rating" value={n} />
          <label for={`star-${n}`} aria-label={`${n} von 5 Sternen`}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.5l2.9 6.6 7.1.7-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7-5.4-4.7 7.1-.7L12 2.5Z" />
            </svg>
          </label>
        </>
      ))}
    </fieldset>
  </div>
  <p class="mt-3 text-center text-sm text-brand-600" data-rating-hint>Tippen Sie auf einen Stern, um zu bewerten.</p>

  <!-- Positiv: 4–5 Sterne -->
  <div class="mt-8" data-panel="positive" hidden>
    <div class="card border-l-4 border-accent-600 p-6 sm:p-8">
      <p class="text-lg font-semibold text-brand-950">Vielen Dank! Es freut uns sehr, dass Sie zufrieden waren.</p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a href={site.googleReviewLink} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Bewertung auf Google schreiben
        </a>
        <button type="button" class="text-sm font-medium text-accent-700 underline underline-offset-2 hover:text-accent-600" data-show-feedback>
          Feedback direkt an uns senden
        </button>
      </div>
    </div>
  </div>

  <!-- Negativ: 1–3 Sterne -->
  <div class="mt-8" data-panel="negative" hidden>
    <div class="card border-l-4 border-brand-900 p-6 sm:p-8">
      <p class="text-lg font-semibold text-brand-950">
        Schade, dass Sie nicht vollständig zufrieden waren. Wir möchten verstehen, was passiert ist und eine
        Lösung finden.
      </p>
      <a href={site.googleReviewLink} target="_blank" rel="noopener noreferrer" class="btn-secondary mt-5 inline-flex">
        Alternativ Bewertung auf Google schreiben
      </a>
    </div>
  </div>

  <!-- Feedback-Formular: bei 1–3 Sternen sofort sichtbar, bei 4–5 Sternen erst nach Klick -->
  <div class="mt-8" data-feedback-wrap hidden>
    <form class="card grid gap-5 p-6 sm:p-8" action="#" method="POST" data-feedback-form novalidate>
      <p class="text-sm text-brand-600" data-rating-display></p>
      <input type="hidden" name="sterne" data-rating-field />

      <!-- Honeypot: für Menschen unsichtbar, Bots füllen es oft blind aus -->
      <div class="hidden" aria-hidden="true">
        <label for="feedback-website">Bitte freilassen</label>
        <input type="text" id="feedback-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="feedback-name" class="mb-1.5 block text-sm font-medium text-brand-900">Name *</label>
          <input
            type="text"
            id="feedback-name"
            name="name"
            required
            autocomplete="name"
            class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
            placeholder="Ihr Name"
          />
        </div>
        <div>
          <label for="feedback-kontakt" class="mb-1.5 block text-sm font-medium text-brand-900">E-Mail oder Telefonnummer *</label>
          <input
            type="text"
            id="feedback-kontakt"
            name="kontakt"
            required
            class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
            placeholder="ihre@email.de oder Telefonnummer"
          />
        </div>

        <div>
          <label for="feedback-leistung" class="mb-1.5 block text-sm font-medium text-brand-900">Welche Leistung wurde durchgeführt?</label>
          <select
            id="feedback-leistung"
            name="leistung"
            class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600"
          >
            <option value="">Bitte wählen (optional)</option>
            {services.map((s) => <option value={s}>{s}</option>)}
            <option value="Sonstiges">Sonstiges / unsicher</option>
          </select>
        </div>

        <div>
          <label for="feedback-foto" class="mb-1.5 block text-sm font-medium text-brand-900">Foto (optional)</label>
          <input
            type="file"
            id="feedback-foto"
            name="foto"
            accept="image/png,image/jpeg,image/webp,image/heic"
            class="w-full rounded-md border-0 bg-brand-50 px-3 py-2.5 text-sm text-brand-950 ring-1 ring-inset ring-brand-950/10 file:mr-3 file:rounded-full file:border-0 file:bg-accent-100 file:px-3.5 file:py-1.5 file:text-xs file:font-medium file:text-accent-700 focus:ring-2 focus:ring-accent-600"
          />
          <p class="mt-1.5 text-xs text-brand-600" data-foto-hint>Bildformate (JPG, PNG, WebP, HEIC), max. 5 MB.</p>
        </div>

        <div class="sm:col-span-2">
          <label for="feedback-was-passiert" class="mb-1.5 block text-sm font-medium text-brand-900">Was ist passiert? *</label>
          <textarea
            id="feedback-was-passiert"
            name="was_passiert"
            required
            rows="3"
            class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
            placeholder="Bitte beschreiben Sie kurz, was vorgefallen ist"
          ></textarea>
        </div>

        <div class="sm:col-span-2">
          <label for="feedback-nachricht" class="mb-1.5 block text-sm font-medium text-brand-900">Nachricht</label>
          <textarea
            id="feedback-nachricht"
            name="nachricht"
            rows="3"
            class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
            placeholder="Weitere Anmerkungen (optional)"
          ></textarea>
        </div>
      </div>

      <label class="flex items-start gap-3 text-sm text-brand-900/80">
        <input
          type="checkbox"
          name="datenschutz"
          required
          class="mt-1 h-4 w-4 rounded border-brand-950/20 text-accent-600 focus:ring-accent-600"
        />
        <span>
          Ich habe die <a href="/datenschutz/" class="underline hover:text-accent-600">Datenschutzerklärung</a>
          zur Kenntnis genommen und bin mit der Verarbeitung meiner Daten zur Bearbeitung meines Feedbacks
          einverstanden. *
        </span>
      </label>

      <p class="text-sm text-red-600" data-feedback-error role="alert" hidden></p>

      <button type="submit" class="btn-primary w-full sm:w-auto">Feedback absenden</button>
    </form>

    <div class="card p-6 text-center sm:p-8" data-feedback-success hidden>
      <p class="text-lg font-semibold text-brand-950">
        Vielen Dank für Ihr Feedback. Wir prüfen Ihr Anliegen und melden uns schnellstmöglich bei Ihnen.
      </p>
    </div>
  </div>
</div>

<style>
  .star-rating {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    border: 0;
    padding: 0;
    margin: 0;
    width: fit-content;
  }

  .star-rating input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .star-rating label {
    cursor: pointer;
    display: block;
    width: clamp(2.75rem, 6vw, 3.25rem);
    height: clamp(2.75rem, 6vw, 3.25rem);
    color: var(--color-brand-100);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .star-rating label svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .star-rating label:hover,
  .star-rating label:hover ~ label,
  .star-rating input:checked ~ label {
    color: var(--color-accent-600);
  }

  .star-rating label:hover {
    transform: scale(1.12);
  }

  .star-rating input:focus-visible + label {
    outline: 2px solid var(--color-accent-600);
    outline-offset: 3px;
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .star-rating label {
      transition: none;
    }
    .star-rating label:hover {
      transform: none;
    }
  }
</style>

<script>
  function setupReviewFlow(root: HTMLElement) {
    const radios = root.querySelectorAll<HTMLInputElement>('[data-star-rating] input[type="radio"]');
    const hint = root.querySelector<HTMLElement>("[data-rating-hint]");
    const positivePanel = root.querySelector<HTMLElement>('[data-panel="positive"]');
    const negativePanel = root.querySelector<HTMLElement>('[data-panel="negative"]');
    const feedbackWrap = root.querySelector<HTMLElement>("[data-feedback-wrap]");
    const showFeedbackBtn = root.querySelector<HTMLElement>("[data-show-feedback]");
    const ratingField = root.querySelector<HTMLInputElement>("[data-rating-field]");
    const ratingDisplay = root.querySelector<HTMLElement>("[data-rating-display]");
    const form = root.querySelector<HTMLFormElement>("[data-feedback-form]");
    const successBox = root.querySelector<HTMLElement>("[data-feedback-success]");
    const errorBox = root.querySelector<HTMLElement>("[data-feedback-error]");
    const fotoInput = root.querySelector<HTMLInputElement>("#feedback-foto");
    const fotoHint = root.querySelector<HTMLElement>("[data-foto-hint]");
    if (!radios.length || !form) return;

    const MAX_PHOTO_BYTES = 5 * 1024 * 1024;
    const ALLOWED_PHOTO_TYPES = ["image/png", "image/jpeg", "image/webp", "image/heic"];
    const defaultFotoHint = fotoHint?.textContent ?? "";

    radios.forEach((radio) => {
      radio.addEventListener("change", () => {
        const value = Number(radio.value);
        hint?.classList.add("hidden");

        if (ratingField) ratingField.value = String(value);
        if (ratingDisplay) {
          ratingDisplay.textContent = `Ihre Bewertung: ${value} von 5 Sternen`;
        }

        if (value >= 4) {
          positivePanel?.removeAttribute("hidden");
          negativePanel?.setAttribute("hidden", "");
          feedbackWrap?.setAttribute("hidden", "");
        } else {
          negativePanel?.removeAttribute("hidden");
          positivePanel?.setAttribute("hidden", "");
          feedbackWrap?.removeAttribute("hidden");
        }
        successBox?.setAttribute("hidden", "");
        form.removeAttribute("hidden");
      });
    });

    showFeedbackBtn?.addEventListener("click", () => {
      feedbackWrap?.removeAttribute("hidden");
      feedbackWrap?.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    fotoInput?.addEventListener("change", () => {
      const file = fotoInput.files?.[0];
      if (!fotoHint) return;
      if (!file) {
        fotoHint.textContent = defaultFotoHint;
        fotoHint.classList.remove("text-red-600");
        return;
      }
      if (!ALLOWED_PHOTO_TYPES.includes(file.type)) {
        fotoHint.textContent = "Dieses Dateiformat wird nicht unterstützt. Bitte JPG, PNG, WebP oder HEIC wählen.";
        fotoHint.classList.add("text-red-600");
        fotoInput.value = "";
        return;
      }
      if (file.size > MAX_PHOTO_BYTES) {
        fotoHint.textContent = "Die Datei ist zu groß. Maximal 5 MB sind erlaubt.";
        fotoHint.classList.add("text-red-600");
        fotoInput.value = "";
        return;
      }
      fotoHint.textContent = defaultFotoHint;
      fotoHint.classList.remove("text-red-600");
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      errorBox?.setAttribute("hidden", "");

      // Honeypot: gefüllt bedeutet höchstwahrscheinlich Bot -> still verwerfen
      const honeypot = form.querySelector<HTMLInputElement>('[name="website"]');
      if (honeypot?.value) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // HINWEIS: Hier fehlt noch die eigentliche Übertragung an ein Backend
      // (siehe Kommentar am Kopf dieser Komponente). Bis dahin wird die
      // Bestätigung ausschließlich clientseitig angezeigt.
      form.setAttribute("hidden", "");
      successBox?.removeAttribute("hidden");
      successBox?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-review-flow]").forEach(setupReviewFlow);
</script>
