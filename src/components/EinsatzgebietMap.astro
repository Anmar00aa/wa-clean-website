---
// Echte interaktive Karte (Leaflet + OpenStreetMap-Kacheln) des tatsächlichen
// Einsatzgebiets. Bewusst KEINE abstrakte/gezeichnete Karte (siehe
// RegionMap.astro, bleibt unbenutzt im Projekt erhalten, falls doch wieder
// eine reduzierte Variante gewünscht wird).
interface Props {
  class?: string;
  lang?: "de" | "en";
}

const { class: className = "", lang = "de" } = Astro.props;
const caption = lang === "en" ? "Our service area: Wiesbaden, Rheingau & Mainz" : "Unser Einsatzgebiet: Wiesbaden, Rheingau & Mainz";
---

<figure class:list={["m-0", className]}>
  <div class="aspect-[4/3] w-full overflow-hidden rounded-lg ring-1 ring-inset ring-brand-100">
    <div id="einsatzgebiet-map" class="h-full w-full" data-map data-lang={lang} aria-label={caption}></div>
  </div>
  <figcaption class="mt-3 text-center text-xs text-brand-600">
    {caption}
  </figcaption>
</figure>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  interface LocationPoint {
    name: string;
    lat: number;
    lng: number;
    primary?: boolean;
    soon?: boolean;
    subtitle?: string;
  }

  // Reale, öffentlich bekannte Ortskoordinaten (Stadtzentrum-Genauigkeit,
  // ausreichend für eine regionale Übersichtskarte).
  function buildLocations(lang: string): LocationPoint[] {
    const isEn = lang === "en";
    return [
      { name: "Wiesbaden", lat: 50.0782, lng: 8.2398, primary: true, subtitle: isEn ? "Head Office" : "Hauptniederlassung" },
      { name: "Oestrich-Winkel", lat: 50.0308, lng: 7.9724, primary: true, subtitle: isEn ? "Rheingau Location" : "Standort Rheingau" },
      { name: "Mainz", lat: 49.9929, lng: 8.2473, soon: true, subtitle: isEn ? "New location – coming soon" : "Neuer Standort – demnächst" },
      { name: "Eltville am Rhein", lat: 50.0273, lng: 8.1197 },
      { name: "Geisenheim", lat: 49.9856, lng: 7.9614 },
      { name: "Rüdesheim am Rhein", lat: 49.9786, lng: 7.9098 },
    ];
  }

  function createIcon(primary: boolean) {
    const size = primary ? 32 : 20;
    const color = primary ? "#17375c" : "#6e6e73";
    const border = primary ? 3 : 2;
    return L.divIcon({
      className: "",
      html: `<span style="
        display:block;
        width:${size}px;height:${size}px;
        background:${color};
        border:${border}px solid #ffffff;
        border-radius:50% 50% 50% 0;
        transform:rotate(-45deg);
        box-shadow:0 2px 6px rgba(29,29,31,0.35);
      "></span>`,
      iconSize: [size, size],
      iconAnchor: [size / 2, size],
      popupAnchor: [0, -size],
    });
  }

  // Neuer Standort (Mainz): grüner Punkt mit pulsierendem Ring.
  function createSoonIcon() {
    const size = 22;
    return L.divIcon({
      className: "",
      html: `<span class="map-soon"><span class="map-soon__ring"></span><span class="map-soon__dot"></span></span>`,
      iconSize: [size, size],
      iconAnchor: [size / 2, size / 2],
      popupAnchor: [0, -size / 2],
    });
  }

  function setupMap(el: HTMLElement) {
    if (el.dataset.mapInit) return;
    el.dataset.mapInit = "1";

    const lang = el.dataset.lang ?? "de";
    const isEn = lang === "en";
    const locations = buildLocations(lang);

    const map = L.map(el, {
      center: [50.02, 8.08],
      zoom: 10,
      scrollWheelZoom: false,
      zoomControl: false,
    });

    L.control.zoom(isEn ? { zoomInTitle: "Zoom in", zoomOutTitle: "Zoom out" } : { zoomInTitle: "Vergrößern", zoomOutTitle: "Verkleinern" }).addTo(map);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: isEn
        ? '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors'
        : '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>-Mitwirkende',
      maxZoom: 18,
    }).addTo(map);

    const markers = locations.map((loc) => {
      const marker = L.marker([loc.lat, loc.lng], {
        icon: loc.soon ? createSoonIcon() : createIcon(!!loc.primary),
      }).addTo(map);
      if (loc.soon) {
        marker.bindTooltip(isEn ? "Mainz · coming soon" : "Mainz · demnächst", {
          permanent: true,
          direction: "right",
          offset: [12, 0],
          className: "map-soon-label",
        });
      }
      marker.bindPopup(
        `<strong>${loc.name}</strong>${loc.subtitle ? `<br><span style="color:#6e6e73">${loc.subtitle}</span>` : ""}`
      );
      return marker;
    });

    const group = L.featureGroup(markers);
    map.fitBounds(group.getBounds().pad(0.25));

    // Scrollrad erst nach Klick zum Zoomen nutzen, damit normales
    // Durchscrollen der Seite über die Karte hinweg nicht "hängen bleibt".
    // Ziehen/Verschieben (Pan) und Zoom-Buttons/Pinch-Zoom funktionieren
    // von Anfang an uneingeschränkt.
    el.addEventListener("click", () => map.scrollWheelZoom.enable());
    el.addEventListener("mouseleave", () => map.scrollWheelZoom.disable());
  }

  document.querySelectorAll<HTMLElement>("[data-map]").forEach(setupMap);
</script>

<style>
  #einsatzgebiet-map {
    min-height: 320px;
  }

  /* Popup dezent an die Website-Typografie/Farben anpassen */
  :global(.leaflet-popup-content-wrapper) {
    border-radius: 10px;
    font-family: var(--font-sans);
  }
  :global(.map-soon) {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
  }
  :global(.map-soon__dot) {
    position: absolute;
    inset: 5px;
    border-radius: 9999px;
    background: #95c234;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 6px rgba(29, 29, 31, 0.35);
  }
  :global(.map-soon__ring) {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgba(149, 194, 52, 0.55);
    animation: map-soon-pulse 1.8s ease-out infinite;
  }
  @keyframes map-soon-pulse {
    0% { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(2.6); opacity: 0; }
  }
  :global(.map-soon-label) {
    border: 0;
    border-radius: 9999px;
    background: #95c234;
    color: #17375c;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 10px;
    box-shadow: 0 2px 6px rgba(29, 29, 31, 0.2);
  }
  :global(.map-soon-label::before) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.map-soon__ring) {
      animation: none;
      opacity: 0.35;
    }
  }
  :global(.leaflet-popup-content) {
    margin: 10px 14px;
    font-size: 0.875rem;
    color: var(--color-brand-950);
  }
</style>
