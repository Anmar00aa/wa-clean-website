---
// Minimalistische, einheitliche Line-Icons (Stroke, kein externes Icon-Set nötig).
export type IconName =
  | "sparkle"
  | "office"
  | "window"
  | "deep-clean"
  | "construction"
  | "stairs"
  | "hotel"
  | "restaurant"
  | "school"
  | "toolbox"
  | "leaf"
  | "snowflake"
  | "phone"
  | "mail"
  | "map-pin"
  | "check"
  | "menu"
  | "close"
  | "chevron-right"
  | "chevron-down"
  | "clock"
  | "shield"
  | "message"
  | "whatsapp"
  | "send"
  | "star";

interface Props {
  name: IconName;
  class?: string;
  id?: string;
}

const { name, class: className = "", id } = Astro.props;
---

<svg
  id={id}
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "sparkle" && (
    <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.5 6.5l2 2M15.5 15.5l2 2M6.5 17.5l2-2M15.5 8.5l2-2" />
  )}
  {name === "office" && (
    <>
      <rect x="4" y="3" width="10" height="18" />
      <rect x="14" y="9" width="6" height="12" />
      <path d="M7 7h1M11 7h1M7 11h1M11 11h1M7 15h1M11 15h1M17 13h1M17 17h1" />
    </>
  )}
  {name === "window" && (
    <>
      <rect x="3" y="3" width="18" height="18" />
      <path d="M12 3v18M3 12h18" />
    </>
  )}
  {name === "deep-clean" && (
    <>
      <path d="M12 2c2.5 3 4 5.5 4 8a4 4 0 0 1-8 0c0-2.5 1.5-5 4-8Z" />
      <path d="M5 21c0-2 1.5-3 3-3s3 1 3 3M13 21c0-1.5 1-2.5 2.5-2.5S18 19.5 18 21" />
    </>
  )}
  {name === "construction" && (
    <>
      <path d="M3 21l8-8M13.5 8.5L18 4l2 2-4.5 4.5M10 15l3-3M6 21l1-3 3-1" />
      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
    </>
  )}
  {name === "stairs" && (
    <path d="M4 21v-4h4v-4h4V9h4V5h4M4 21h16" />
  )}
  {name === "hotel" && (
    <>
      <path d="M3 21V8l9-5 9 5v13" />
      <path d="M3 21h18M9 21v-6h6v6" />
    </>
  )}
  {name === "restaurant" && (
    <>
      <path d="M7 2v8a2 2 0 0 0 2 2v10M7 2v20M7 6h0M17 2v8a2 2 0 0 1-4 0V2M15 12v10" />
    </>
  )}
  {name === "school" && (
    <>
      <path d="M12 3l9 4.5-9 4.5-9-4.5L12 3Z" />
      <path d="M6 10.5V16c0 1.5 2.5 3 6 3s6-1.5 6-3v-5.5" />
    </>
  )}
  {name === "toolbox" && (
    <>
      <rect x="3" y="9" width="18" height="10" rx="1" />
      <path d="M8 9V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3M3 13h18" />
    </>
  )}
  {name === "leaf" && (
    <path d="M20 4C10 4 4 10 4 18c8 0 14-6 14-14ZM6 20c2-4 5-7 9-9" />
  )}
  {name === "snowflake" && (
    <path d="M12 2v20M4.5 7l15 10M19.5 7l-15 10M9 4l3 3 3-3M9 20l3-3 3 3M4 9.5l1 4-4 1M23 9.5l-1 4 4 1M0 9.5l1 4-4 1" />
  )}
  {name === "phone" && (
    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2C10.5 21 3 13.5 3 6a2 2 0 0 1 2-2Z" />
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="M4 6.5l8 6 8-6" />
    </>
  )}
  {name === "map-pin" && (
    <>
      <path d="M12 22s7-7.4 7-12.5A7 7 0 0 0 5 9.5C5 14.6 12 22 12 22Z" />
      <circle cx="12" cy="9.5" r="2.3" />
    </>
  )}
  {name === "check" && <path d="M4 12.5l5 5L20 6" />}
  {name === "menu" && <path d="M3 6h18M3 12h18M3 18h18" />}
  {name === "close" && <path d="M5 5l14 14M19 5L5 19" />}
  {name === "chevron-right" && <path d="M9 5l7 7-7 7" />}
  {name === "chevron-down" && <path d="M5 9l7 7 7-7" />}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3.5 2" />
    </>
  )}
  {name === "shield" && (
    <path d="M12 2l8 3.5V11c0 5.5-3.5 9-8 11-4.5-2-8-5.5-8-11V5.5L12 2Z" />
  )}
  {name === "message" && (
    <path d="M4 4h16v12H8l-4 4V4Z" />
  )}
  {name === "whatsapp" && (
    <>
      <path d="M4 20l1.2-4.1A8 8 0 1 1 8.6 19L4 20Z" />
      <path
        fill="currentColor"
        stroke="none"
        d="M9.3 8.4c.2-.4.4-.4.6-.4h.4c.2 0 .4 0 .5.4.2.4.6 1.4.6 1.5.1.1.1.2 0 .4-.1.1-.1.2-.2.3l-.3.4c-.1.1-.2.2-.1.4.2.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.2.2.1.4.1.5-.1.2-.2.6-.7.8-.9.1-.2.3-.2.5-.1l1.4.7c.2.1.3.1.4.2.1.2.1.7-.1 1.3-.2.6-1.3 1.2-1.9 1.2-.5 0-1.1.1-3.5-1.4-2.9-1.8-3.5-3.8-3.6-4-.1-.2-.8-1.1-.8-2s.5-1.4.6-1.6Z"
      />
    </>
  )}
  {name === "send" && (
    <path d="M4 12l16-8-6 16-3-6-7-2Z" />
  )}
  {name === "star" && (
    <path d="M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6L12 3Z" />
  )}
</svg>
