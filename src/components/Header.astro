---
import { site, mainNav, mainNavEn, locations } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  lang?: "de" | "en";
  alternateHref?: string;
}

const { lang = "de", alternateHref } = Astro.props;
const nav = lang === "en" ? mainNavEn : mainNav;
const currentPath = Astro.url.pathname;

const t = lang === "en"
  ? { requestQuote: "Request a Quote", openMenu: "Open menu", callNow: site.phoneDisplay, mobil: "mobile" }
  : { requestQuote: "Angebot anfordern", openMenu: "Menü öffnen", callNow: site.phoneDisplay, mobil: "mobil" };

function isActive(href: string) {
  if (href === "/" || href === "/en/") return currentPath === href;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-brand-950/[0.06] bg-white/95 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between sm:h-20">
    <a href={lang === "en" ? "/en/" : "/"} class="relative flex items-center" data-logo-sparkle>
      <img src="/logo-horizontal.png" alt={site.name} class="h-11 w-auto sm:h-[3.25rem] lg:h-11 xl:h-[3.25rem]" width="1142" height="400" />
      <span class="logo-sparkle" style="left:23.4%;top:3.4%" aria-hidden="true"></span>
      <span class="logo-sparkle" style="left:26.1%;top:5.7%" aria-hidden="true"></span>
      <span class="logo-sparkle" style="left:24.6%;top:12.7%" aria-hidden="true"></span>
    </a>

    <nav class="hidden lg:block" aria-label={lang === "en" ? "Main navigation" : "Hauptnavigation"}>
      <ul class="flex items-center gap-5 xl:gap-7">
        {nav.map((item) => (
          <li class:list={["children" in item && item.children && "group relative"]}>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-1 whitespace-nowrap text-[0.95rem] font-medium transition-colors hover:text-accent-600",
                isActive(item.href) ? "text-accent-600" : "text-brand-900",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
              {"children" in item && item.children && <Icon name="chevron-down" class="h-3.5 w-3.5" />}
            </a>
            {"children" in item && item.children && (
              <ul class="invisible absolute left-0 top-full z-50 mt-3 w-56 rounded-lg bg-white p-2 opacity-0 shadow-xl ring-1 ring-brand-950/10 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block rounded-md px-3 py-2 text-sm font-medium text-brand-900 hover:bg-brand-50 hover:text-accent-600">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      {alternateHref && (
        <a
          href={alternateHref}
          class="rounded-full px-2.5 py-1 text-xs font-semibold text-brand-600 ring-1 ring-inset ring-brand-100 hover:text-accent-600"
          aria-label={lang === "en" ? "Zur deutschen Version wechseln" : "Switch to English"}
        >
          {lang === "en" ? "DE" : "EN"}
        </a>
      )}

      <div class="relative" data-phone-popover>
        <button
          type="button"
          class="flex items-center gap-2 whitespace-nowrap text-sm font-semibold text-brand-900 hover:text-accent-600"
          aria-haspopup="dialog"
          aria-expanded="false"
          data-phone-trigger
        >
          <Icon name="phone" class="h-4 w-4" />
          Wiesbaden | Rheingau
        </button>

        <div
          class="absolute right-0 top-full z-50 mt-3 hidden w-72 rounded-lg bg-white p-4 ring-1 ring-brand-950/10 shadow-xl"
          role="dialog"
          aria-label={lang === "en" ? "Phone numbers by location" : "Telefonnummern nach Standort"}
          data-phone-panel
          hidden
        >
          {locations.map((loc, i) => (
            <div class:list={[i > 0 && "mt-3 border-t border-brand-100 pt-3"]}>
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{loc.isMain ? "Wiesbaden" : "Rheingau"}</p>
              <a href={loc.phoneHref} class="mt-1.5 flex items-center gap-2 text-sm text-brand-950 hover:text-accent-600">
                <Icon name="phone" class="h-3.5 w-3.5 shrink-0" />
                {loc.phoneDisplay}
              </a>
              <a href={loc.mobileHref} class="mt-1 flex items-center gap-2 text-sm text-brand-700 hover:text-accent-600">
                <Icon name="phone" class="h-3.5 w-3.5 shrink-0" />
                {loc.mobileDisplay} <span class="text-xs text-brand-500">({t.mobil})</span>
              </a>
            </div>
          ))}
          <div class="mt-3 border-t border-brand-100 pt-3">
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-brand-600">
              Mainz <span class="soon-badge normal-case tracking-normal">{lang === "en" ? "coming soon" : "demnächst"}</span>
            </p>
          </div>
        </div>
      </div>
      <a href={lang === "en" ? "/en/contact/" : "/kontakt/"} class="btn-primary whitespace-nowrap">{t.requestQuote}</a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-md text-brand-900 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.openMenu}
    >
      <Icon name="menu" class="h-6 w-6" id="menu-icon-open" />
      <Icon name="close" class="hidden h-6 w-6" id="menu-icon-close" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-brand-950/[0.06] bg-white lg:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label={lang === "en" ? "Mobile navigation" : "Mobile Navigation"}>
      {nav.map((item) => (
        <>
          <a
            href={item.href}
            class:list={[
              "rounded-md px-3 py-2.5 text-base font-medium",
              isActive(item.href) ? "bg-brand-50 text-accent-600" : "text-brand-900",
            ]}
          >
            {item.label}
          </a>
          {"children" in item && item.children && (
            <div class="ml-3 flex flex-col gap-1 border-l border-brand-100 pl-3">
              {item.children.map((child) => (
                <a href={child.href} class="rounded-md px-3 py-2 text-sm font-medium text-brand-700 hover:text-accent-600">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </>
      ))}
      <a href={lang === "en" ? "/en/contact/" : "/kontakt/"} class="btn-primary mt-3 w-full">{t.requestQuote}</a>
      <a href={site.phoneHref} class="btn-secondary mt-2 w-full">
        <Icon name="phone" class="h-4 w-4" />
        {site.phoneDisplay}
      </a>
      {alternateHref && (
        <a href={alternateHref} class="mt-2 w-full rounded-md px-3 py-2.5 text-center text-sm font-medium text-brand-600 ring-1 ring-inset ring-brand-100">
          {lang === "en" ? "Deutsch" : "English"}
        </a>
      )}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  // Telefon-Popover: Wiesbaden | Rheingau
  const phonePopover = document.querySelector<HTMLElement>("[data-phone-popover]");
  const phoneTrigger = phonePopover?.querySelector<HTMLButtonElement>("[data-phone-trigger]");
  const phonePanel = phonePopover?.querySelector<HTMLElement>("[data-phone-panel]");

  function closePhonePanel() {
    phonePanel?.setAttribute("hidden", "");
    phoneTrigger?.setAttribute("aria-expanded", "false");
  }

  function openPhonePanel() {
    phonePanel?.removeAttribute("hidden");
    phoneTrigger?.setAttribute("aria-expanded", "true");
  }

  phoneTrigger?.addEventListener("click", () => {
    const isOpen = phoneTrigger.getAttribute("aria-expanded") === "true";
    if (isOpen) closePhonePanel();
    else openPhonePanel();
  });

  document.addEventListener("click", (e) => {
    if (!phonePopover) return;
    if (!phonePopover.contains(e.target as Node)) closePhonePanel();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closePhonePanel();
      phoneTrigger?.focus();
    }
  });
</script>
