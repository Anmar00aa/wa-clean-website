---
// Einmal pro Seite eingebunden (siehe Layout.astro).
// Scroll-Reveal: Inhalte blenden beim Scrollen sanft ein (.reveal / .reveal-group).
// Respektiert prefers-reduced-motion vollständig.
---

<script is:inline>
  (function () {
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var revealTargets = document.querySelectorAll(".reveal, .reveal-group");
    if (!revealTargets.length) return;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealTargets.forEach(function (el) {
        el.classList.add("is-visible");
      });
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
    );
    revealTargets.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>
