---
// HINWEIS: Der Versand ist noch nicht an ein Backend angebunden.
// Für eine statische Astro-Seite eignet sich z. B. Netlify Forms, Formspree
// oder eine eigene API-Route. Bis dahin ist "action" ein Platzhalter.
// Validierung/Spam-Schutz/Erfolgsmeldung teilen sich mit QuickRequestForm.astro
// dieselbe Logik, siehe src/lib/formSubmit.ts.
import { site } from "../config/site";

interface Props {
  services: string[];
  presetService?: string;
}

const { services, presetService } = Astro.props;
---

<div class="reveal" data-inline-form-wrap>
<form
  class="card grid gap-5 p-6 sm:p-8"
  action="#"
  method="POST"
  id="angebot-formular"
  data-inline-form
  novalidate
>
  <!-- Honeypot: für Menschen unsichtbar, Bots füllen es oft blind aus -->
  <div class="hidden" aria-hidden="true">
    <label for="angebot-website">Bitte freilassen</label>
    <input type="text" id="angebot-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label for="name" class="mb-1.5 block text-sm font-medium text-brand-900">Name / Firma *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="Ihr Name oder Firmenname"
      />
    </div>

    <div>
      <label for="telefon" class="mb-1.5 block text-sm font-medium text-brand-900">Telefonnummer *</label>
      <input
        type="tel"
        id="telefon"
        name="telefon"
        required
        autocomplete="tel"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="Ihre Telefonnummer"
      />
    </div>

    <div>
      <label for="email" class="mb-1.5 block text-sm font-medium text-brand-900">E-Mail *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="ihre@email.de"
      />
    </div>

    <div>
      <label for="leistung" class="mb-1.5 block text-sm font-medium text-brand-900">Gewünschte Leistung</label>
      <select
        id="leistung"
        name="leistung"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 focus:ring-2 focus:ring-accent-600"
      >
        <option value="">Bitte wählen (optional)</option>
        {services.map((s) => (
          <option value={s} selected={s === presetService}>{s}</option>
        ))}
        <option value="Sonstiges">Sonstiges / unsicher</option>
      </select>
    </div>

    <div>
      <label for="ort" class="mb-1.5 block text-sm font-medium text-brand-900">Ort / PLZ *</label>
      <input
        type="text"
        id="ort"
        name="ort"
        required
        autocomplete="postal-code"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="z. B. 65375 Oestrich-Winkel"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="nachricht" class="mb-1.5 block text-sm font-medium text-brand-900">Nachricht</label>
      <textarea
        id="nachricht"
        name="nachricht"
        rows="4"
        class="w-full rounded-md border-0 bg-brand-50 px-4 py-3 text-brand-950 ring-1 ring-inset ring-brand-950/10 placeholder:text-brand-900/40 focus:ring-2 focus:ring-accent-600"
        placeholder="Kurze Beschreibung Ihres Anliegens (optional)"
      ></textarea>
    </div>
  </div>

  <label class="flex items-start gap-3 text-sm text-brand-900/80">
    <input
      type="checkbox"
      name="datenschutz"
      required
      class="mt-1 h-4 w-4 rounded border-brand-950/20 text-accent-600 focus:ring-accent-600"
    />
    <span>
      Ich habe die <a href="/datenschutz/" class="underline hover:text-accent-600">Datenschutzerklärung</a>
      zur Kenntnis genommen und bin mit der Verarbeitung meiner Daten zur Bearbeitung meiner Anfrage einverstanden. *
    </span>
  </label>

  <button type="submit" class="btn-primary w-full sm:w-auto">
    Unverbindlich &amp; kostenlos anfragen
  </button>

  <p class="text-xs text-brand-900/50">
    Alternativ erreichen Sie uns telefonisch unter {site.phoneDisplay} oder per E-Mail an {site.email}.
  </p>
</form>

<div class="card p-6 text-center sm:p-8" data-inline-form-success hidden>
  <p class="text-lg font-semibold text-brand-950">Vielen Dank für Ihre Anfrage!</p>
  <p class="mt-2 text-sm text-brand-700">
    Wir haben Ihre Angaben erhalten und melden uns schnellstmöglich mit einem unverbindlichen Angebot bei Ihnen.
  </p>
</div>
</div>

<script>
  import { setupInlineForm } from "../lib/formSubmit";

  document.querySelectorAll<HTMLElement>("[data-inline-form-wrap]").forEach((wrap) => {
    const form = wrap.querySelector<HTMLFormElement>("[data-inline-form]");
    const successBox = wrap.querySelector<HTMLElement>("[data-inline-form-success]");
    if (form) setupInlineForm(form, successBox);
  });
</script>
