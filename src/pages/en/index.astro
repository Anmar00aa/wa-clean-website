---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import QuickRequestFormEn from "../../components/QuickRequestFormEn.astro";
import EinsatzgebietMap from "../../components/EinsatzgebietMap.astro";
import PartnerLogos from "../../components/PartnerLogos.astro";
import GlassWipeHero from "../../components/GlassWipeHero.astro";
import B2BSection from "../../components/B2BSection.astro";
import VorherNachherShowcase from "../../components/VorherNachherShowcase.astro";
import GoogleReviewsShowcase from "../../components/GoogleReviewsShowcase.astro";
import QuoteWizardEn from "../../components/QuoteWizardEn.astro";
import Icon from "../../components/Icon.astro";
import { site, regions } from "../../config/site";

const allServices = (await getCollection("leistungenEn")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
const featuredServices = allServices.filter((s) => s.data.featured);
const allServiceTitles = allServices.map((s) => s.data.title);

const trustPoints = [
  { icon: "message" as const, title: "Direct points of contact", text: "Personal service without unnecessary detours." },
  { icon: "clock" as const, title: "Flexible scheduling", text: "Cleaning that fits your business operations." },
  { icon: "check" as const, title: "Transparent quotes", text: "Clear services and comprehensible terms." },
  { icon: "shield" as const, title: "Short travel distances", text: "No extra travel costs for recurring contracts within 30 km of Wiesbaden or Oestrich-Winkel." },
  { icon: "sparkle" as const, title: "For private & commercial", text: "Flexible solutions for businesses, property managers and private clients." },
];

const stats = [
  { value: "30 km", label: "No travel costs for recurring contracts" },
  { value: "2+1", label: "Locations – Wiesbaden & Oestrich-Winkel, Mainz coming soon" },
  { value: "100%", label: "Personal service & direct points of contact" },
];

const steps = [
  { title: "Send your enquiry", text: "Let us know briefly what needs to be cleaned." },
  { title: "Site visit & quote", text: "If needed, we visit the property and prepare a custom quote." },
  { title: "Cleaning begins", text: "Once you approve, we schedule the work and get started." },
];
---

<Layout
  lang="en"
  title="Professional Building Cleaning for Businesses & Private Clients"
  description="Building cleaning in the Rheingau, in Wiesbaden and Mainz – routine cleaning, office cleaning, window cleaning and more. Reliable, professional, no-obligation quote."
>
  <!-- Hero -->
  <section class="relative touch-pan-y overflow-hidden bg-brand-950 lg:min-h-[660px]">
    <GlassWipeHero image="/work/action-fensterwischer-fassade.jpg" alt="WA-Clean staff member professionally cleaning a glass facade" />
    <div class="container-page relative z-10 py-16 sm:py-20 lg:py-24">
      <div class="lg:max-w-[46%] xl:max-w-[42%]" data-hero-text-zone>
        <p class="eyebrow text-accent-400">Building Cleaning in Wiesbaden &amp; the Rheingau</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-[3.1rem]">
          Professional Building Cleaning for Businesses &amp; Private Clients
        </h1>
        <p class="mt-5 max-w-xl text-[1.3125rem] font-light leading-relaxed text-brand-100/85">
          Professional building cleaning for businesses and private clients in Wiesbaden, the Rheingau and
          Mainz. From regular routine and office cleaning to window cleaning, deep cleaning and winter
          service – reliable, thorough and flexible.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/en/contact/" class="btn-primary text-base">
            Request a Free Quote
          </a>
          <a href={site.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
            <Icon name="phone" class="h-4 w-4" />
            Call Now
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-brand-100/70">
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Commercial &amp; private</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Tailored concepts</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> No-obligation quote</li>
        </ul>
      </div>
    </div>

    <div
      class="relative z-10 px-5 pb-14 sm:px-6 lg:absolute lg:inset-y-0 lg:right-6 lg:flex lg:w-[370px] lg:items-center lg:px-0 lg:pb-0 xl:w-[400px]"
      data-hero-form-zone
    >
      <div class="w-full">
        <QuickRequestFormEn services={allServiceTitles} />
      </div>
    </div>
  </section>

  <!-- Trust-Bar -->
  <section class="border-b border-brand-100 bg-warm-50 py-3.5">
    <div class="container-page">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-center text-xs font-medium text-brand-700 sm:text-sm">
        <li>Direct point of contact</li>
        <li class="hidden sm:block text-brand-100">•</li>
        <li>Flexible scheduling</li>
        <li class="hidden sm:block text-brand-100">•</li>
        <li>Commercial &amp; private</li>
        <li class="hidden sm:block text-brand-100">•</li>
        <li>Free enquiry</li>
      </ul>
    </div>
  </section>

  <!-- Partner -->
  <section class="py-12 sm:py-14">
    <div class="container-page">
      <p class="reveal mb-8 text-center text-sm font-medium text-brand-600">Partners who trust us</p>
      <PartnerLogos />
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-16 sm:py-20 lg:py-24">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Our Services</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Cleaning from a single source</h2>
        <p class="mt-4 text-brand-700">
          From ongoing upkeep to a one-off deep clean – choose the service that fits your building, or let
          us advise you.
        </p>
      </div>

      <div class="reveal-group mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredServices.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.kurzbeschreibung}
            href={`/en/services/${service.id}/`}
            icon={service.data.icon}
          />
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/en/services/" class="btn-secondary">
          View All Services
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section class="bg-warm-50 py-16 sm:py-20 lg:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Service Area</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Serving the Rheingau, Wiesbaden &amp; Mainz</h2>
        <p class="mt-4 text-brand-700">
          With our head office in Wiesbaden and our branch in Oestrich-Winkel, we serve customers across
          the Rheingau, Wiesbaden and the greater Mainz area. Short travel distances mean flexible
          scheduling and reliable service for businesses, property managers and private clients.
        </p>
        <p class="mt-3 text-brand-700">
          We're also happy to take on properties outside the areas listed, by arrangement. Just get in
          touch and mention your location.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {["Wiesbaden", "Rheingau", "Mainz"].map((region) => (
            <span class="rounded-full bg-accent-600 px-4 py-2 text-sm font-semibold text-white">
              {region}
            </span>
          ))}
          {regions.filter((r) => !["Wiesbaden", "Rheingau", "Mainz"].includes(r)).map((region) => (
            <span class="rounded-full bg-white px-4 py-2 text-sm font-medium text-brand-950 ring-1 ring-inset ring-brand-100">
              {region}
            </span>
          ))}
        </div>
        <a href="/en/service-area/" class="btn-secondary mt-8">
          Service Area in Detail
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
      <EinsatzgebietMap class="reveal" lang="en" />
    </div>
  </section>

  <!-- Stats -->
  <section class="relative overflow-hidden bg-brand-950 py-16 sm:py-20 lg:py-24">
    <img
      src="/work/action-glasdach-spiderman.jpg"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/85 via-brand-950/80 to-brand-950/90"></div>
    <div class="container-page relative">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow text-accent-400">Facts &amp; Figures</p>
        <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Cleanliness you can rely on</h2>
        <p class="mt-4 text-brand-100/80">
          Reliable building services for businesses and private clients in Wiesbaden, the Rheingau and Mainz.
        </p>
      </div>
      <div class="reveal-group mt-12 grid gap-8 sm:grid-cols-3">
        {stats.map((stat) => (
          <div class="reveal-item text-center">
            <p class="text-4xl font-semibold text-white sm:text-5xl">{stat.value}</p>
            <p class="mt-2 text-sm text-brand-100/75">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why WA-Clean -->
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Why WA-Clean?</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">What you can count on</h2>
      </div>

      <div class="reveal-group mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {trustPoints.map((point) => (
          <div class="reveal-item text-center sm:text-left">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-950 sm:mx-0">
              <Icon name={point.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-brand-950">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700">{point.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-warm-50 py-16 sm:py-20 lg:py-24">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Process</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">3 Steps to Your Cleaning Service</h2>
      </div>
      <div class="reveal-group mt-12 grid gap-8 sm:grid-cols-3">
        {steps.map((step, i) => (
          <div class="reveal-item text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent-600 text-lg font-semibold text-white">
              {i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-brand-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <B2BSection lang="en" />

  <!-- About Us Teaser -->
  <section class="bg-warm-100 py-16 sm:py-20 lg:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal order-2 aspect-[4/3] w-full overflow-hidden rounded-lg lg:order-1">
        <img
          src="/work/action-gardine-fenster.jpg"
          alt="WA-Clean staff member cleaning a window"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="reveal order-1 lg:order-2">
        <p class="eyebrow">About Us</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Personal, reliable, direct</h2>
        <p class="mt-4 text-brand-700 leading-relaxed">
          It matters to us that customers can trust us for the long term. Instead of anonymous standard
          processes, we rely on direct communication, fixed points of contact and a way of working that
          prioritises quality over speed at any cost.
        </p>
        <a href="/en/about-us/" class="btn-secondary mt-8">
          Learn More About Us
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <VorherNachherShowcase lang="en" />

  <GoogleReviewsShowcase lang="en" />

  <!-- Quote Assistant -->
  <section id="quote" class="bg-warm-50 py-16 sm:py-20 lg:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-start">
      <div class="reveal">
        <p class="eyebrow">Request a Quote in 60 Seconds</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Get a No-Obligation Quote Now</h2>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Answer a few quick questions – we'll get back to you promptly with a suitable, no-obligation
          quote. No commitment required.
        </p>
        <div class="mt-6 space-y-3 text-sm text-brand-900">
          <p class="flex items-center gap-2"><Icon name="phone" class="h-4 w-4 text-accent-600" /> {site.phoneDisplay}</p>
          <p class="flex items-center gap-2"><Icon name="mail" class="h-4 w-4 text-accent-600" /> {site.email}</p>
        </div>
      </div>
      <QuoteWizardEn services={allServiceTitles} />
    </div>
  </section>
</Layout>
