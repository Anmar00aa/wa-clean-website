---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ServiceCard from "../../../components/ServiceCard.astro";

const allServices = (await getCollection("leistungenEn")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
---

<Layout
  lang="en"
  title="Services"
  description="All cleaning services at a glance: routine cleaning, office cleaning, window cleaning, deep cleaning, caretaker service, winter service and more in the Rheingau and Wiesbaden."
>
  <Breadcrumbs items={[{ label: "Home", href: "/en/" }, { label: "Services", href: "/en/services/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Services</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">All Services at a Glance</h1>
        <p class="mt-4 text-lg text-brand-700">
          Whether it's ongoing cleaning, a one-off job, or all-round building care – choose the service that
          fits, or simply get in touch and tell us what you need.
        </p>
      </div>

      <div class="reveal-group mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {allServices.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.kurzbeschreibung}
            href={`/en/services/${service.id}/`}
            icon={service.data.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-950 py-14 sm:py-16">
    <div class="container-page flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">Can't find the right service?</h2>
      <p class="max-w-xl text-brand-100/80">
        Just describe what you need – together we'll find the right solution for your building.
      </p>
      <a href="/en/contact/" class="btn-primary">Request a Free Quote</a>
    </div>
  </section>
</Layout>
