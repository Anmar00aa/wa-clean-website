---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import { locations, getWhatsappHref } from "../../config/site";

const whatsappHref = getWhatsappHref("en");

const districts = [
  "Mitte", "Westend", "Südost", "Nordost", "Rheingauviertel", "Biebrich", "Schierstein", "Dotzheim",
  "Klarenthal", "Erbenheim", "Bierstadt", "Sonnenberg", "Nordenstadt", "Delkenheim", "Igstadt",
  "Kloppenheim", "Auringen", "Medenbach", "Naurod", "Rambach", "Heßloch", "Frauenstein",
  "Mainz-Kastel", "Mainz-Kostheim", "Amöneburg",
];

const wiesbaden = locations[0];

const keyServices = [
  { title: "Office Cleaning", href: "/en/services/bueroreinigung/", text: "Regular cleaning for offices, law firms and administrative buildings." },
  { title: "Routine Cleaning", href: "/en/services/unterhaltsreinigung/", text: "Ongoing cleaning for commercial properties and residential complexes." },
  { title: "Window & Glass Cleaning", href: "/en/services/fenster-glasreinigung/", text: "Streak-free windows for office and commercial buildings." },
  { title: "Stairwell Cleaning", href: "/en/services/treppenhausreinigung/", text: "Well-kept entrances and stairwells for property managers." },
];

const faq = [
  { question: "What does building cleaning cost in Wiesbaden?", answer: "Costs depend on property size, scope of service and how often cleaning takes place. We're happy to prepare an individual, no-obligation quote for properties in Wiesbaden." },
  { question: "Which districts of Wiesbaden do you serve?", answer: "We serve all of Wiesbaden – from Biebrich and Schierstein to Dotzheim and the city centre, right through to Erbenheim, Bierstadt, Nordenstadt and the other districts." },
  { question: "Do you also clean in Mainz-Kastel and Mainz-Kostheim?", answer: "Yes. The AKK districts of Mainz-Kastel, Mainz-Kostheim and Amöneburg belong to Wiesbaden and are part of our regular service area." },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Layout
  lang="en"
  title="Building Cleaning Wiesbaden"
  description="Professional building cleaning in Wiesbaden and all districts: office, routine and window cleaning for businesses, property managers and private clients. Free quote."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

  <Breadcrumbs items={[{ label: "Home", href: "/en/" }, { label: "Building Cleaning Wiesbaden", href: "/en/wiesbaden/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Head Office</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Building Cleaning Across Wiesbaden</h1>
        <p class="mt-6 text-brand-700 leading-relaxed">
          As the state capital of Hesse, Wiesbaden is our home: from {wiesbaden.street} in {wiesbaden.zip}{" "}
          {wiesbaden.city}, we serve businesses, property managers, practices and private clients across
          the whole city. Short travel distances mean flexible scheduling and reliable, personal service
          for you.
        </p>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Whether it's an office building in the city centre, a residential complex in Biebrich, or a
          practice in Sonnenberg – we know the city and adapt our cleaning concepts to your property and
          your daily routine.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/en/contact/" class="btn-primary">Request a Free Quote</a>
          <a href={wiesbaden.phoneHref} class="btn-secondary">
            <Icon name="phone" class="h-4 w-4" /> {wiesbaden.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="reveal aspect-[4/3] w-full overflow-hidden rounded-lg">
        <img src="/work/action-eingang-staubsaugen.jpg" alt="Cleaning an entrance area in Wiesbaden" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Service Area</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Building Cleaning Across All of Wiesbaden</h2>
        <p class="mt-4 text-brand-700">
          From Biebrich and Schierstein to Dotzheim and Wiesbaden's city centre, right through to
          Erbenheim, Bierstadt and Nordenstadt: WA-Clean serves businesses, property managers and private
          clients in Wiesbaden and its surrounding districts.
        </p>
      </div>
      <div class="reveal-group mt-8 flex flex-wrap justify-center gap-2">
        {districts.map((d) => (
          <span class="reveal-item rounded-full bg-white px-4 py-2 text-sm font-medium text-brand-950 ring-1 ring-inset ring-brand-100">
            {d}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Services in Wiesbaden</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Particularly in Demand</h2>
      </div>
      <div class="reveal-group mt-10 grid gap-5 sm:grid-cols-2">
        {keyServices.map((l) => (
          <a href={l.href} class="reveal-item card block p-6 transition-colors hover:border-accent-600">
            <h3 class="font-semibold text-brand-950">{l.title}</h3>
            <p class="mt-2 text-sm text-brand-700">{l.text}</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/en/services/" class="btn-secondary">View All Services</a>
      </div>
    </div>
  </section>

  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Why WA-Clean</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Your Local Cleaning Partner</h2>
      </div>
      <div class="reveal-group mt-10 grid gap-6 sm:grid-cols-3">
        <div class="reveal-item text-center">
          <Icon name="message" class="mx-auto h-6 w-6 text-accent-600" />
          <h3 class="mt-3 font-semibold text-brand-950">Direct Point of Contact</h3>
          <p class="mt-2 text-sm text-brand-700">Personal service without call-centre detours.</p>
        </div>
        <div class="reveal-item text-center">
          <Icon name="shield" class="mx-auto h-6 w-6 text-accent-600" />
          <h3 class="mt-3 font-semibold text-brand-950">No Travel Costs</h3>
          <p class="mt-2 text-sm text-brand-700">For recurring contracts within a 30 km radius of our head office.</p>
        </div>
        <div class="reveal-item text-center">
          <Icon name="clock" class="mx-auto h-6 w-6 text-accent-600" />
          <h3 class="mt-3 font-semibold text-brand-950">Flexible Scheduling</h3>
          <p class="mt-2 text-sm text-brand-700">Cleaning times that fit your business operations.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-page max-w-2xl">
      <h2 class="reveal text-2xl font-semibold sm:text-3xl">Frequently Asked Questions About Wiesbaden</h2>
      <div class="mt-6 space-y-4">
        {faq.map((f) => (
          <details class="group card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-brand-950 marker:content-none">
              {f.question}
              <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-brand-500 transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-brand-700">{f.answer}</p>
          </details>
        ))}
      </div>
      <a href="/en/faq/" class="btn-secondary mt-8">All Questions &amp; Answers</a>
    </div>
  </section>

  <section class="bg-brand-950 py-14 sm:py-16">
    <div class="container-page flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">Looking for reliable building cleaning in Wiesbaden?</h2>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/en/contact/" class="btn-primary">Request a Free Quote</a>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
          <Icon name="whatsapp" class="h-4 w-4" /> WhatsApp
        </a>
        <a href={wiesbaden.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
          <Icon name="phone" class="h-4 w-4" /> Call Now
        </a>
      </div>
    </div>
  </section>
</Layout>
