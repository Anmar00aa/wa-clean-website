---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { locations, getWhatsappHref } from "../config/site";

const whatsappHref = getWhatsappHref("de");

const stadtteile = [
  "Mitte", "Westend", "Südost", "Nordost", "Rheingauviertel", "Biebrich", "Schierstein", "Dotzheim",
  "Klarenthal", "Erbenheim", "Bierstadt", "Sonnenberg", "Nordenstadt", "Delkenheim", "Igstadt",
  "Kloppenheim", "Auringen", "Medenbach", "Naurod", "Rambach", "Heßloch", "Frauenstein",
  "Mainz-Kastel", "Mainz-Kostheim", "Amöneburg",
];

const wiesbaden = locations[0];

const wichtigsteLeistungen = [
  { title: "Büroreinigung", href: "/leistungen/bueroreinigung/", text: "Regelmäßige Reinigung für Büros, Kanzleien und Verwaltungsgebäude." },
  { title: "Unterhaltsreinigung", href: "/leistungen/unterhaltsreinigung/", text: "Laufende Reinigung für Gewerbeobjekte und Wohnanlagen." },
  { title: "Fenster- & Glasreinigung", href: "/leistungen/fenster-glasreinigung/", text: "Streifenfreie Fenster für Büro- und Geschäftsgebäude." },
  { title: "Treppenhausreinigung", href: "/leistungen/treppenhausreinigung/", text: "Gepflegte Eingangs- und Treppenbereiche für Hausverwaltungen." },
];

const faq = [
  {
    question: "Was kostet eine Gebäudereinigung in Wiesbaden?",
    answer: "Die Kosten hängen von Objektgröße, Leistungsumfang und Reinigungshäufigkeit ab. Für Objekte in Wiesbaden erstellen wir Ihnen gerne ein individuelles, unverbindliches Angebot.",
  },
  {
    question: "In welchen Wiesbadener Stadtteilen sind Sie tätig?",
    answer: "Wir sind in ganz Wiesbaden im Einsatz – von Biebrich und Schierstein über Dotzheim und die Innenstadt bis nach Erbenheim, Bierstadt und Nordenstadt sowie den weiteren Stadtteilen.",
  },
  {
    question: "Reinigen Sie auch in Mainz-Kastel und Mainz-Kostheim?",
    answer: "Ja. Die AKK-Stadtteile Mainz-Kastel, Mainz-Kostheim und Amöneburg gehören zu Wiesbaden und liegen in unserem regulären Einsatzgebiet.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Layout
  title="Gebäudereinigung Wiesbaden"
  description="Professionelle Gebäudereinigung in Wiesbaden und allen Stadtteilen: Büro-, Unterhalts- und Fensterreinigung für Unternehmen, Hausverwaltungen und Privatkunden. Kostenloses Angebot."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Gebäudereinigung Wiesbaden", href: "/gebaeudereinigung-wiesbaden/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Hauptniederlassung</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Gebäudereinigung in ganz Wiesbaden</h1>
        <p class="mt-6 text-brand-700 leading-relaxed">
          Als hessische Landeshauptstadt ist Wiesbaden unser Zuhause: Von hier, {wiesbaden.street} in{" "}
          {wiesbaden.zip} {wiesbaden.city}, betreuen wir Unternehmen, Hausverwaltungen, Praxen und
          Privatkunden in der gesamten Stadt. Kurze Anfahrtswege bedeuten für Sie flexible Termine und
          eine zuverlässige, persönliche Betreuung.
        </p>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Ob Bürogebäude in der Innenstadt, Wohnanlage in Biebrich oder Praxis in Sonnenberg – wir kennen
          die Stadt und passen unsere Reinigungskonzepte an Ihr Objekt und Ihren Alltag an.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/kontakt/" class="btn-primary">Kostenloses Angebot anfordern</a>
          <a href={wiesbaden.phoneHref} class="btn-secondary">
            <Icon name="phone" class="h-4 w-4" /> {wiesbaden.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="reveal aspect-[4/3] w-full overflow-hidden rounded-lg">
        <img src="/work/action-eingang-staubsaugen.jpg" alt="Reinigung eines Eingangsbereichs in Wiesbaden" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Stadtteile -->
  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Einsatzgebiet</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Gebäudereinigung in ganz Wiesbaden</h2>
        <p class="mt-4 text-brand-700">
          Von Biebrich und Schierstein über Dotzheim und die Wiesbadener Innenstadt bis nach Erbenheim,
          Bierstadt und Nordenstadt: WA-Clean ist in Wiesbaden und den umliegenden Stadtteilen für
          Unternehmen, Hausverwaltungen und Privatkunden im Einsatz.
        </p>
      </div>
      <div class="reveal-group mt-8 flex flex-wrap justify-center gap-2">
        {stadtteile.map((s) => (
          <span class="reveal-item rounded-full bg-white px-4 py-2 text-sm font-medium text-brand-950 ring-1 ring-inset ring-brand-100">
            {s}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Leistungen in Wiesbaden</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Besonders gefragt</h2>
      </div>
      <div class="reveal-group mt-10 grid gap-5 sm:grid-cols-2">
        {wichtigsteLeistungen.map((l) => (
          <a href={l.href} class="reveal-item card block p-6 transition-colors hover:border-accent-600">
            <h3 class="font-semibold text-brand-950">{l.title}</h3>
            <p class="mt-2 text-sm text-brand-700">{l.text}</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/leistungen/" class="btn-secondary">Alle Leistungen ansehen</a>
      </div>
    </div>
  </section>

  <!-- Warum WA-Clean -->
  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Warum WA-Clean</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Ihr Reinigungspartner vor Ort</h2>
      </div>
      <div class="reveal-group mt-10 grid gap-6 sm:grid-cols-3">
        <div class="reveal-item text-center">
          <Icon name="message" class="mx-auto h-6 w-6 text-accent-600" />
          <h3 class="mt-3 font-semibold text-brand-950">Direkter Ansprechpartner</h3>
          <p class="mt-2 text-sm text-brand-700">Persönliche Betreuung ohne Callcenter-Umwege.</p>
        </div>
        <div class="reveal-item text-center">
          <Icon name="shield" class="mx-auto h-6 w-6 text-accent-600" />
          <h3 class="mt-3 font-semibold text-brand-950">Keine Anfahrtskosten</h3>
          <p class="mt-2 text-sm text-brand-700">Bei Daueraufträgen im 30-km-Umkreis um unsere Hauptniederlassung.</p>
        </div>
        <div class="reveal-item text-center">
          <Icon name="clock" class="mx-auto h-6 w-6 text-accent-600" />
          <h3 class="mt-3 font-semibold text-brand-950">Flexible Termine</h3>
          <p class="mt-2 text-sm text-brand-700">Reinigungszeiten passend zu Ihrem Betriebsablauf.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 sm:py-16">
    <div class="container-page max-w-2xl">
      <h2 class="reveal text-2xl font-semibold sm:text-3xl">Häufige Fragen zu Wiesbaden</h2>
      <div class="mt-6 space-y-4">
        {faq.map((f) => (
          <details class="group card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-brand-950 marker:content-none">
              {f.question}
              <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-brand-500 transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-brand-700">{f.answer}</p>
          </details>
        ))}
      </div>
      <a href="/faq/" class="btn-secondary mt-8">Alle Fragen &amp; Antworten</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-950 py-14 sm:py-16">
    <div class="container-page flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">Sie suchen eine zuverlässige Gebäudereinigung in Wiesbaden?</h2>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/kontakt/" class="btn-primary">Kostenloses Angebot anfordern</a>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
          <Icon name="whatsapp" class="h-4 w-4" /> WhatsApp
        </a>
        <a href={wiesbaden.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
          <Icon name="phone" class="h-4 w-4" /> Jetzt anrufen
        </a>
      </div>
    </div>
  </section>
</Layout>
