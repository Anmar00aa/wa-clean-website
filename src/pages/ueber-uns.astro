---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";

const values = [
  {
    icon: "message" as const,
    title: "Direkte Kommunikation",
    text: "Kurze Wege, klare Absprachen und ein fester Ansprechpartner statt anonymer Callcenter.",
  },
  {
    icon: "shield" as const,
    title: "Verlässlichkeit",
    text: "Vereinbarte Termine werden eingehalten – damit Sie sich auf uns verlassen können.",
  },
  {
    icon: "sparkle" as const,
    title: "Qualität statt Schnelligkeit",
    text: "Sorgfältige Ausführung hat für uns Vorrang vor möglichst schnellen Einsätzen.",
  },
  {
    icon: "check" as const,
    title: "Langfristige Zusammenarbeit",
    text: "Wir arbeiten auf dauerhafte Kundenbeziehungen hin, nicht auf einmalige Aufträge.",
  },
];
---

<Layout
  title="Über uns"
  description="Lernen Sie das Team hinter Ihrer Gebäudereinigung im Rheingau kennen – persönlich, professionell und mit dem Anspruch auf langfristige, verlässliche Zusammenarbeit."
>
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Über uns", href: "/ueber-uns/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Über uns</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Persönlich, professionell, direkt</h1>
        <p class="mt-6 text-brand-700 leading-relaxed">
          Hinter jedem sauberen Gebäude steht ein Team, das seine Arbeit ernst nimmt. Uns ist wichtig, dass
          Kundinnen und Kunden sich auf uns verlassen können – nicht nur bei einem einmaligen Einsatz, sondern
          über Jahre hinweg.
        </p>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Deshalb setzen wir auf klare Absprachen, feste Ansprechpartner und eine Arbeitsweise, die sich an
          Ihrem Gebäude und Ihrem Alltag orientiert – ob Büro, Praxis, Wohnanlage oder Privathaushalt.
        </p>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Gute Zusammenarbeit entsteht aus Vertrauen. Wir arbeiten deshalb transparent: Sie wissen, was
          gereinigt wird, wann es passiert und was es kostet – ohne versteckte Zusatzkosten.
        </p>
      </div>
      <div class="reveal grid grid-cols-2 gap-3">
        <div class="col-span-2 aspect-[16/10] w-full overflow-hidden rounded-lg">
          <img
            src="/work/team-van.jpg"
            alt="Das WA-Clean Team vor Ort mit Firmenfahrzeug"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="aspect-square w-full overflow-hidden rounded-lg">
          <img
            src="/work/action-flur-wischen.jpg"
            alt="WA-Clean Mitarbeiter bei der Unterhaltsreinigung"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex aspect-square w-full items-center rounded-lg bg-brand-50 p-4">
          <p class="text-sm leading-relaxed text-brand-700">
            Unser Team ist regelmäßig mit eigenem Fahrzeug und vollständiger Ausrüstung in Wiesbaden und im
            Rheingau unterwegs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Was uns wichtig ist</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Unsere Grundsätze</h2>
      </div>
      <div class="reveal-group mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="reveal-item card p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-50 text-brand-950">
              <Icon name={v.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-brand-950">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-page flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-semibold sm:text-3xl">Lernen Sie uns kennen</h2>
      <p class="max-w-xl text-brand-700">
        Am besten funktioniert Vertrauen im persönlichen Gespräch. Kontaktieren Sie uns – wir nehmen uns Zeit
        für Ihr Anliegen.
      </p>
      <a href="/kontakt/" class="btn-primary">Kostenloses Angebot anfordern</a>
    </div>
  </section>
</Layout>
