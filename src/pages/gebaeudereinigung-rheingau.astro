---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import ConsentMap from "../components/ConsentMap.astro";
import { site, locations, partners, getWhatsappHref } from "../config/site";

const whatsappHref = getWhatsappHref("de");

const orte = [
  "Oestrich-Winkel", "Oestrich", "Winkel", "Mittelheim", "Eltville am Rhein", "Erbach", "Martinsthal",
  "Rauenthal", "Geisenheim", "Rüdesheim am Rhein", "Assmannshausen", "Lorch", "Kiedrich", "Walluf",
  "Johannisberg", "Hattenheim", "Hallgarten",
];

const rheingau = locations[1];

const wichtigsteLeistungen = [
  { title: "Gastronomiereinigung", href: "/leistungen/gastronomiereinigung/", text: "Für Weingüter, Restaurants und Gastronomiebetriebe im Rheingau." },
  { title: "Fenster- & Glasreinigung", href: "/leistungen/fenster-glasreinigung/", text: "Klare Sicht für Gasträume, Vinotheken und Ferienwohnungen." },
  { title: "Gartenpflege", href: "/leistungen/gartenpflege/", text: "Gepflegte Außenanlagen für Weingüter und Privathaushalte." },
  { title: "Unterhaltsreinigung", href: "/leistungen/unterhaltsreinigung/", text: "Regelmäßige Reinigung für Hotels, Pensionen und Gewerbeobjekte." },
];

const branchenLeistungen = [
  { title: "Weingutreinigung", text: "Produktions- und Verkostungsräume, Kellereien und Verwaltungsbereiche – abgestimmt auf den Betrieb während und außerhalb der Saison." },
  { title: "Vinothekreinigung", text: "Gepflegte Verkaufs- und Präsentationsflächen für Vinotheken, damit Glas, Theken und Böden immer einladend wirken." },
  { title: "Ferienwohnungsreinigung", text: "Zuverlässige Endreinigung zwischen den Gästewechseln, damit Ihre Ferienwohnung pünktlich übergabebereit ist." },
];

const steps = [
  { title: "Anfrage senden", text: "Teilen Sie uns kurz mit, was im Rheingau gereinigt werden soll." },
  { title: "Besichtigung & Angebot", text: "Bei Bedarf besichtigen wir das Objekt vor Ort und erstellen ein individuelles Angebot." },
  { title: "Reinigung starten", text: "Nach Ihrer Freigabe planen wir den Einsatz und legen los." },
];

const referenzNamen = [
  "Weingut Prinz von Hessen",
  "Weingut Goldatzel",
  "Hochschule Geisenheim",
  "EBS Universität",
  "Rhein Pavillon Da Nico",
  "Kloster Marienthal",
  "mowa – Padel Geisenheim",
  "Campingplatz Hattenheim",
];
const referenzen = partners.filter((p) => referenzNamen.includes(p.name));

const faq = [
  {
    question: "Haben Sie einen eigenen Standort im Rheingau?",
    answer: `Ja. Unser zweiter Standort liegt in ${rheingau.city}, ${rheingau.street}. Von dort betreuen wir den gesamten Rheingau mit kurzen Anfahrtswegen.`,
  },
  {
    question: "Reinigen Sie auch für Weingüter und Gastronomiebetriebe?",
    answer: "Ja. Wir betreuen bereits Weingüter, Restaurants und Gastronomiebetriebe im Rheingau und kennen die besonderen Anforderungen an Gasträume, Vinotheken und Außenbereiche.",
  },
  {
    question: "Übernehmen Sie auch kurzfristige Einsätze in der Saison?",
    answer: "Wir bemühen uns, gerade in touristisch stark frequentierten Zeiten flexibel zu unterstützen. Die tatsächliche Verfügbarkeit hängt von unserer aktuellen Auslastung ab – sprechen Sie uns einfach an.",
  },
  {
    question: "Reinigen Sie auch Ferienwohnungen zwischen Gästewechseln?",
    answer: "Ja. Für Vermieter im Rheingau übernehmen wir die Endreinigung zwischen zwei Gästewechseln, damit die Wohnung pünktlich und gepflegt für die nächsten Gäste bereitsteht.",
  },
  {
    question: "Was kostet die Reinigung für ein Weingut oder eine Vinothek?",
    answer: "Das hängt stark vom Betrieb ab – Produktionsflächen, Verkostungsräume und Verkaufsflächen haben unterschiedliche Anforderungen. Wir schauen uns Ihren Betrieb gerne an und erstellen ein passendes, unverbindliches Angebot.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: `${site.legalName} – Standort Rheingau`,
  url: `${site.url}/gebaeudereinigung-rheingau/`,
  telephone: rheingau.phoneHref.replace("tel:", ""),
  email: site.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: rheingau.street,
    postalCode: rheingau.zip,
    addressLocality: rheingau.city,
    addressCountry: "DE",
  },
  areaServed: { "@type": "Place", name: "Rheingau" },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "08:00", closes: "20:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Saturday"], opens: "10:00", closes: "18:00" },
  ],
  priceRange: "$$",
};

const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${rheingau.street}, ${rheingau.zip} ${rheingau.city}`)}&output=embed`;
---

<Layout
  title="Gebäudereinigung Rheingau"
  description="Gebäudereinigung im Rheingau: Wir betreuen Weingüter, Gastronomie, Hotels und Privatkunden in Oestrich-Winkel, Eltville, Geisenheim, Rüdesheim und Umgebung. Kostenloses Angebot."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} is:inline />

  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Gebäudereinigung Rheingau", href: "/gebaeudereinigung-rheingau/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Standort Rheingau</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Gebäudereinigung mitten im Rheingau</h1>
        <p class="mt-6 text-brand-700 leading-relaxed">
          Der Rheingau lebt von seinen Weingütern, seiner Gastronomie und seinem Tourismus entlang des
          Rheins – ein gepflegtes Erscheinungsbild ist hier besonders wichtig. Von unserem Standort in{" "}
          {rheingau.city} aus betreuen wir Betriebe und Privatkunden zwischen Walluf und Rüdesheim mit
          kurzen Anfahrtswegen und flexiblen Terminen.
        </p>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Ob Weingut, Restaurant, Ferienwohnung oder Privathaushalt: Wir passen unsere Reinigungsleistungen
          an die Abläufe und Anforderungen Ihres Betriebs an – von der laufenden Unterhaltsreinigung bis
          zur Endreinigung zwischen zwei Gästewechseln.
        </p>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Unser Team vor Ort in {rheingau.city} kennt die Region und ihre Betriebe – Ihr fester
          Ansprechpartner ist {rheingau.manager}. Für Objekte in Wiesbaden und Mainz sind wir über unsere
          Hauptniederlassung ebenfalls erreichbar.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/kontakt/" class="btn-primary">Kostenloses Angebot anfordern</a>
          <a href={rheingau.phoneHref} class="btn-secondary">
            <Icon name="phone" class="h-4 w-4" /> {rheingau.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="reveal aspect-[4/3] w-full overflow-hidden rounded-lg">
        <img src="/work/action-gardine-fenster.jpg" alt="Fensterreinigung eines Gastronomiebetriebs im Rheingau" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Orte -->
  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Einsatzgebiet</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Im gesamten Rheingau für Sie da</h2>
        <p class="mt-4 text-brand-700">
          Von Oestrich-Winkel über Eltville und Geisenheim bis nach Rüdesheim am Rhein und Assmannshausen:
          WA-Clean ist im gesamten Rheingau für Weingüter, Gastronomiebetriebe, Hotels und Privatkunden
          im Einsatz.
        </p>
      </div>
      <div class="reveal-group mt-8 flex flex-wrap justify-center gap-2">
        {orte.map((o) => (
          <span class="reveal-item rounded-full bg-white px-4 py-2 text-sm font-medium text-brand-950 ring-1 ring-inset ring-brand-100">
            {o}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Leistungen im Rheingau</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Besonders gefragt</h2>
      </div>
      <div class="reveal-group mt-10 grid gap-5 sm:grid-cols-2">
        {wichtigsteLeistungen.map((l) => (
          <a href={l.href} class="reveal-item card block p-6 transition-colors hover:border-accent-600">
            <h3 class="font-semibold text-brand-950">{l.title}</h3>
            <p class="mt-2 text-sm text-brand-700">{l.text}</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/leistungen/" class="btn-secondary">Alle Leistungen ansehen</a>
      </div>
    </div>
  </section>

  <!-- Branchenspezifische Leistungen -->
  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Speziell für die Region</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Weingüter, Vinotheken & Ferienwohnungen</h2>
      </div>
      <div class="reveal-group mt-10 grid gap-6 sm:grid-cols-3">
        {branchenLeistungen.map((b) => (
          <div class="reveal-item card p-6">
            <h3 class="font-semibold text-brand-950">{b.title}</h3>
            <p class="mt-2 text-sm text-brand-700">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- So funktioniert's -->
  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Ablauf</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">In 3 Schritten zu Ihrer Reinigung</h2>
      </div>
      <div class="reveal-group mt-10 grid gap-8 sm:grid-cols-3">
        {steps.map((step, i) => (
          <div class="reveal-item text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent-600 text-lg font-semibold text-white">
              {i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-brand-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {referenzen.length > 0 && (
    <section class="bg-warm-50 py-14 sm:py-16">
      <div class="container-page">
        <div class="reveal mx-auto max-w-2xl text-center">
          <p class="eyebrow">Referenzen</p>
          <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Diese Kunden vertrauen uns im Rheingau</h2>
        </div>
        <div class="reveal-group mt-10 grid grid-cols-2 items-center gap-8 sm:grid-cols-3">
          {referenzen.map((r) => (
            <div class="reveal-item flex items-center justify-center p-4">
              <img src={r.logo} alt={r.name} class="max-h-14 w-full object-contain grayscale transition-all hover:grayscale-0" />
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/referenzen/" class="btn-secondary">Alle Referenzen ansehen</a>
        </div>
      </div>
    </section>
  )}

  <!-- Karte -->
  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">So finden Sie uns</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Standort Rheingau</h2>
        <p class="mt-4 text-brand-700">{rheingau.street}, {rheingau.zip} {rheingau.city}</p>
      </div>
      <div class="reveal mt-8 aspect-[16/9] w-full overflow-hidden rounded-lg ring-1 ring-inset ring-brand-100">
        <ConsentMap src={mapEmbedSrc} title="Karte: WA-Clean Standort Rheingau" address={`${rheingau.street}, ${rheingau.zip} ${rheingau.city}`} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page max-w-2xl">
      <h2 class="reveal text-2xl font-semibold sm:text-3xl">Häufige Fragen zum Rheingau</h2>
      <div class="mt-6 space-y-4">
        {faq.map((f) => (
          <details class="group card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-brand-950 marker:content-none">
              {f.question}
              <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-brand-500 transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-brand-700">{f.answer}</p>
          </details>
        ))}
      </div>
      <a href="/faq/" class="btn-secondary mt-8">Alle Fragen &amp; Antworten</a>
    </div>
  </section>

  <!-- Weitere Standorte -->
  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Auch interessant</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Unsere weiteren Standorte</h2>
      </div>
      <div class="reveal-group mt-8 grid gap-5 sm:grid-cols-2">
        <a href="/gebaeudereinigung-wiesbaden/" class="reveal-item card block p-6 transition-colors hover:border-accent-600">
          <h3 class="font-semibold text-brand-950">Gebäudereinigung Wiesbaden</h3>
          <p class="mt-2 text-sm text-brand-700">Unsere Hauptniederlassung betreut die Landeshauptstadt und alle Stadtteile.</p>
        </a>
        <a href="/gebaeudereinigung-mainz/" class="reveal-item card block p-6 transition-colors hover:border-accent-600">
          <h3 class="font-semibold text-brand-950">Gebäudereinigung Mainz</h3>
          <p class="mt-2 text-sm text-brand-700">Von Wiesbaden aus sind wir auch für Objekte in Mainz und Umgebung im Einsatz.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-950 py-14 sm:py-16">
    <div class="container-page flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">Sie suchen eine zuverlässige Gebäudereinigung im Rheingau?</h2>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/kontakt/" class="btn-primary">Kostenloses Angebot anfordern</a>
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
          <Icon name="whatsapp" class="h-4 w-4" /> WhatsApp
        </a>
        <a href={rheingau.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
          <Icon name="phone" class="h-4 w-4" /> Jetzt anrufen
        </a>
      </div>
    </div>
  </section>
</Layout>
