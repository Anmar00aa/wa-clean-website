---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { site } from "../../config/site";

export async function getStaticPaths() {
  const services = await getCollection("leistungen");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service, allServices: services },
  }));
}

const { service, allServices } = Astro.props;
const { Content } = await render(service);
const allServiceTitles = allServices
  .sort((a: typeof service, b: typeof service) => a.data.reihenfolge - b.data.reihenfolge)
  .map((s: typeof service) => s.data.title);

const otherServices = allServices
  .filter((s: typeof service) => s.id !== service.id)
  .sort((a: typeof service, b: typeof service) => a.data.reihenfolge - b.data.reihenfolge)
  .slice(0, 3);
---

<Layout title={service.data.title} description={service.data.metaDescription}>
  <Breadcrumbs
    items={[
      { label: "Startseite", href: "/" },
      { label: "Leistungen", href: "/leistungen/" },
      { label: service.data.title, href: `/leistungen/${service.id}/` },
    ]}
  />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div>
        <div class="flex items-center gap-3">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-950">
            <Icon name={service.data.icon as any} class="h-6 w-6" />
          </span>
          <p class="eyebrow">Leistung</p>
        </div>
        <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">{service.data.title}</h1>
        <p class="mt-4 text-lg text-brand-700">{service.data.kurzbeschreibung}</p>

        <div class="prose prose-p:text-brand-700 prose-p:leading-relaxed mt-8 max-w-none">
          <Content />
        </div>

        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          <div>
            <h2 class="text-lg font-semibold text-brand-950">Ihre Vorteile</h2>
            <ul class="reveal-group mt-4 space-y-3">
              {service.data.vorteile.map((v: string) => (
                <li class="reveal-item flex items-start gap-2.5 text-sm text-brand-700">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
                  {v}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2 class="text-lg font-semibold text-brand-950">Typischer Leistungsumfang</h2>
            <ul class="reveal-group mt-4 space-y-3">
              {service.data.leistungsumfang.map((v: string) => (
                <li class="reveal-item flex items-start gap-2.5 text-sm text-brand-700">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
                  {v}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-10">
          <h2 class="text-lg font-semibold text-brand-950">Geeignet für</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {service.data.zielgruppen.map((z: string) => (
              <span class="rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-950 ring-1 ring-inset ring-brand-100">
                {z}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a href="#anfrage" class="btn-primary">Kostenloses Angebot anfordern</a>
          <a href={site.phoneHref} class="btn-secondary">
            <Icon name="phone" class="h-4 w-4" />
            {site.phoneDisplay}
          </a>
        </div>
      </div>

      <div id="anfrage" class="scroll-mt-24 lg:sticky lg:top-24">
        <h2 class="mb-4 text-lg font-semibold text-brand-950">Angebot für {service.data.title} anfragen</h2>
        <ContactForm services={allServiceTitles} presetService={service.data.title} />
      </div>
    </div>
  </section>

  {otherServices.length > 0 && (
    <section class="bg-brand-50 py-14 sm:py-16">
      <div class="container-page">
        <h2 class="text-2xl font-semibold sm:text-3xl">Weitere Leistungen</h2>
        <div class="reveal-group mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {otherServices.map((s: typeof service) => (
            <ServiceCard
              title={s.data.title}
              description={s.data.kurzbeschreibung}
              href={`/leistungen/${s.id}/`}
              icon={s.data.icon}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
