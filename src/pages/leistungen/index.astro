---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ServiceCard from "../../components/ServiceCard.astro";

const allServices = (await getCollection("leistungen")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
---

<Layout
  title="Leistungen"
  description="Alle Reinigungsleistungen im Überblick: Unterhaltsreinigung, Büroreinigung, Fensterreinigung, Grundreinigung, Hausmeisterservice, Winterdienst und mehr im Rheingau und in Wiesbaden."
>
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Leistungen", href: "/leistungen/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Leistungen</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Alle Leistungen im Überblick</h1>
        <p class="mt-4 text-lg text-brand-700">
          Ob laufende Reinigung, einmaliger Einsatz oder Betreuung rund ums Gebäude – wählen Sie die passende
          Leistung oder sprechen Sie uns direkt auf Ihr Anliegen an.
        </p>
      </div>

      <div class="reveal-group mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {allServices.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.kurzbeschreibung}
            href={`/leistungen/${service.id}/`}
            icon={service.data.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-950 py-14 sm:py-16">
    <div class="container-page flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-semibold text-white sm:text-3xl">Nicht die passende Leistung gefunden?</h2>
      <p class="max-w-xl text-brand-100/80">
        Beschreiben Sie uns einfach Ihr Anliegen – wir finden gemeinsam die richtige Lösung für Ihr Gebäude.
      </p>
      <a href="/kontakt/" class="btn-primary">Kostenloses Angebot anfordern</a>
    </div>
  </section>
</Layout>
