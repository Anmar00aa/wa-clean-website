---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import QuickRequestForm from "../components/QuickRequestForm.astro";
import EinsatzgebietMap from "../components/EinsatzgebietMap.astro";
import PartnerLogos from "../components/PartnerLogos.astro";
import GlassWipeHero from "../components/GlassWipeHero.astro";
import B2BSection from "../components/B2BSection.astro";
import VorherNachherShowcase from "../components/VorherNachherShowcase.astro";
import GoogleReviewsShowcase from "../components/GoogleReviewsShowcase.astro";
import QuoteWizard from "../components/QuoteWizard.astro";
import Icon from "../components/Icon.astro";
import { site, regions, managers } from "../config/site";

const allServices = (await getCollection("leistungen")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge
);
const featuredServices = allServices.filter((s) => s.data.featured);
const allServiceTitles = allServices.map((s) => s.data.title);

const trustPoints = [
  {
    icon: "message" as const,
    title: "Direkte Ansprechpartner",
    text: "Persönliche Betreuung ohne unnötige Umwege.",
  },
  {
    icon: "clock" as const,
    title: "Flexible Termine",
    text: "Reinigung passend zu Ihrem Betriebsablauf.",
  },
  {
    icon: "check" as const,
    title: "Transparente Angebote",
    text: "Klare Leistungen und nachvollziehbare Konditionen.",
  },
  {
    icon: "shield" as const,
    title: "Kurze Anfahrtswege",
    text: "Bei Daueraufträgen bis 30 km um Wiesbaden oder Oestrich-Winkel keine zusätzlichen Anfahrtskosten.",
  },
  {
    icon: "sparkle" as const,
    title: "Für Privat & Gewerbe",
    text: "Flexible Lösungen für Unternehmen, Hausverwaltungen und Privatkunden.",
  },
];

const stats = [
  { value: "30 km", label: "Keine Anfahrtskosten bei Daueraufträgen" },
  { value: "2+1", label: "Standorte – Wiesbaden & Oestrich-Winkel, Mainz demnächst" },
  { value: "100%", label: "Persönlicher Service & direkte Ansprechpartner" },
];

const steps = [
  {
    title: "Anfrage senden",
    text: "Teilen Sie uns kurz mit, was gereinigt werden soll.",
  },
  {
    title: "Besichtigung & Angebot",
    text: "Bei Bedarf besichtigen wir das Objekt und erstellen ein individuelles Angebot.",
  },
  {
    title: "Reinigung starten",
    text: "Nach Ihrer Freigabe planen wir den Einsatz und legen los.",
  },
];
---

<Layout
  title="Professionelle Gebäudereinigung für Unternehmen & Privatkunden"
  description="Gebäudereinigung im Rheingau, in Wiesbaden und Mainz – Unterhaltsreinigung, Büroreinigung, Fensterreinigung und mehr. Zuverlässig, professionell, unverbindliches Angebot."
>
  <!-- Hero -->
  <section class="relative touch-pan-y overflow-hidden bg-brand-950 lg:min-h-[660px]">
    <GlassWipeHero image="/work/action-fensterwischer-fassade.jpg" alt="WA-Clean Mitarbeiter bei der professionellen Fensterreinigung einer Glasfassade" />
    <div class="container-page relative z-10 py-16 sm:py-20 lg:py-24">
      <!-- Textgruppe: bewusst als EINE Einheit, kompakter/weiter links als zuvor -->
      <div class="lg:max-w-[46%] xl:max-w-[42%]" data-hero-text-zone>
        <p class="eyebrow text-accent-400">Gebäudereinigung in Wiesbaden &amp; im Rheingau</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-[3.1rem]">
          Professionelle Gebäudereinigung für Unternehmen &amp; Privatkunden
        </h1>
        <p class="mt-5 max-w-xl text-[1.3125rem] font-light leading-relaxed text-brand-100/85">
          Professionelle Gebäudereinigung für Unternehmen und Privatkunden in Wiesbaden, im Rheingau und in
          Mainz. Von der regelmäßigen Unterhalts- und Büroreinigung bis zur Fensterreinigung, Grundreinigung
          und zum Winterdienst – zuverlässig, sorgfältig und flexibel.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/kontakt/" class="btn-primary text-base">
            Kostenloses Angebot anfordern
          </a>
          <a href={site.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 px-[19px] py-[10px] text-[0.95rem] text-white transition-colors hover:bg-white/10">
            <Icon name="phone" class="h-4 w-4" />
            Jetzt anrufen
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-brand-100/70">
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Gewerbe &amp; Privat</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Individuelle Konzepte</li>
          <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-accent-400" /> Unverbindliches Angebot</li>
        </ul>
      </div>
    </div>

    <!-- Quick-Anfrageformular: rechts, an der Position des früheren Teamfotos -->
    <div
      class="relative z-10 px-5 pb-14 sm:px-6 lg:absolute lg:inset-y-0 lg:right-6 lg:flex lg:w-[370px] lg:items-center lg:px-0 lg:pb-0 xl:w-[400px]"
      data-hero-form-zone
    >
      <div class="w-full">
        <QuickRequestForm services={allServiceTitles} />
      </div>
    </div>
  </section>

  <!-- Trust-Bar -->
  <section class="border-b border-brand-100 bg-warm-50 py-3.5">
    <div class="container-page">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-center text-xs font-medium text-brand-700 sm:text-sm">
        <li>Persönlicher Ansprechpartner</li>
        <li class="hidden sm:block text-brand-100">•</li>
        <li>Flexible Termine</li>
        <li class="hidden sm:block text-brand-100">•</li>
        <li>Gewerbe &amp; Privat</li>
        <li class="hidden sm:block text-brand-100">•</li>
        <li>Kostenlose Anfrage</li>
      </ul>
    </div>
  </section>

  <!-- Partner -->
  <section class="py-12 sm:py-14">
    <div class="container-page">
      <p class="reveal mb-8 text-center text-sm font-medium text-brand-600">Partner, die uns vertrauen</p>
      <PartnerLogos />
    </div>
  </section>

  <!-- Leistungen -->
  <section id="leistungen" class="py-16 sm:py-20 lg:py-24">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Unsere Leistungen</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Reinigung aus einer Hand</h2>
        <p class="mt-4 text-brand-700">
          Vom laufenden Unterhalt bis zur einmaligen Grundreinigung – wählen Sie die Leistung, die zu Ihrem
          Gebäude passt, oder lassen Sie sich beraten.
        </p>
      </div>

      <div class="reveal-group mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredServices.map((service) => (
          <ServiceCard
            title={service.data.title}
            description={service.data.kurzbeschreibung}
            href={`/leistungen/${service.id}/`}
            icon={service.data.icon}
          />
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/leistungen/" class="btn-secondary">
          Alle Leistungen ansehen
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Einsatzgebiet -->
  <section class="bg-warm-50 py-16 sm:py-20 lg:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Einsatzgebiet</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Für Sie im Rheingau, in Wiesbaden &amp; Mainz</h2>
        <p class="mt-4 text-brand-700">
          Mit unserer Hauptniederlassung in Wiesbaden und unserem Standort in Oestrich-Winkel sind wir im
          Rheingau, in Wiesbaden und im Raum Mainz für unsere Kunden im Einsatz. Kurze Anfahrtswege
          ermöglichen uns flexible Termine und eine zuverlässige Betreuung von Unternehmen,
          Hausverwaltungen und Privatkunden.
        </p>
        <p class="mt-3 text-brand-700">
          Auch außerhalb der genannten Orte übernehmen wir Objekte gerne nach Absprache. Sprechen Sie uns
          einfach auf Ihren Standort an.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {["Wiesbaden", "Rheingau", "Mainz"].map((region) => (
            <span class="rounded-full bg-accent-600 px-4 py-2 text-sm font-semibold text-white">
              {region}
            </span>
          ))}
          {regions.filter((r) => !["Wiesbaden", "Rheingau", "Mainz"].includes(r)).map((region) => (
            <span class="rounded-full bg-white px-4 py-2 text-sm font-medium text-brand-950 ring-1 ring-inset ring-brand-100">
              {region}
            </span>
          ))}
        </div>
        <a href="/einsatzgebiet/" class="btn-secondary mt-8">
          Einsatzgebiet im Detail
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
      <EinsatzgebietMap class="reveal" />
    </div>
  </section>

  <!-- Zahlen & Fakten -->
  <section class="relative overflow-hidden bg-brand-950 py-16 sm:py-20 lg:py-24">
    <img
      src="/work/action-glasdach-spiderman.jpg"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/85 via-brand-950/80 to-brand-950/90"></div>
    <div class="container-page relative">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow text-accent-400">Zahlen &amp; Fakten</p>
        <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">Sauberkeit, auf die Sie sich verlassen können</h2>
        <p class="mt-4 text-brand-100/80">
          Zuverlässiger Gebäudeservice für Unternehmen und Privatkunden in Wiesbaden, im Rheingau und in Mainz.
        </p>
      </div>
      <div class="reveal-group mt-12 grid gap-8 sm:grid-cols-3">
        {stats.map((stat) => (
          <div class="reveal-item text-center">
            <p class="text-4xl font-semibold text-white sm:text-5xl">{stat.value}</p>
            <p class="mt-2 text-sm text-brand-100/75">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Warum WA-Clean -->
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Warum WA-Clean?</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Darauf können Sie sich verlassen</h2>
      </div>

      <div class="reveal-group mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {trustPoints.map((point) => (
          <div class="reveal-item text-center sm:text-left">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-950 sm:mx-0">
              <Icon name={point.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 text-base font-semibold text-brand-950">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700">{point.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- So funktioniert's -->
  <section class="bg-warm-50 py-16 sm:py-20 lg:py-24">
    <div class="container-page">
      <div class="reveal mx-auto max-w-2xl text-center">
        <p class="eyebrow">Ablauf</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">In 3 Schritten zu Ihrer Reinigung</h2>
      </div>
      <div class="reveal-group mt-12 grid gap-8 sm:grid-cols-3">
        {steps.map((step, i) => (
          <div class="reveal-item text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent-600 text-lg font-semibold text-white">
              {i + 1}
            </span>
            <h3 class="mt-4 text-base font-semibold text-brand-950">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <B2BSection />

  <!-- Über uns Teaser -->
  <section class="bg-warm-100 py-16 sm:py-20 lg:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="reveal order-2 grid grid-cols-2 gap-4 lg:order-1">
        {managers.map((m) => (
          <figure class="m-0 overflow-hidden rounded-lg bg-[#0b0b0b]">
            <img src={m.photo} alt={`${m.name}, ${m.roleDe}`} width={m.width} height={m.height} loading="lazy" class="aspect-[4/5] h-auto w-full object-cover object-top" />
            <figcaption class="bg-white px-3 py-2.5 ring-1 ring-inset ring-brand-100">
              <span class="block text-sm font-semibold text-brand-950">{m.name}</span>
              <span class="block text-xs text-brand-700">{m.roleDe}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="reveal order-1 lg:order-2">
        <p class="eyebrow">Über uns</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Persönlich, verlässlich, direkt</h2>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Uns ist wichtig, dass Kundinnen und Kunden uns langfristig vertrauen können. Statt anonymer
          Standardprozesse setzen wir auf direkte Kommunikation, feste Ansprechpartner und eine Arbeitsweise,
          die auf Qualität statt auf Schnelligkeit um jeden Preis ausgelegt ist.
        </p>
        <a href="/ueber-uns/" class="btn-secondary mt-8">
          Mehr über uns erfahren
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <VorherNachherShowcase />

  <GoogleReviewsShowcase />

  <!-- Bewertung -->
  <section class="py-14 sm:py-16">
    <div class="container-page">
      <div class="reveal card flex flex-col items-center gap-3 bg-accent-100 p-8 text-center ring-1 ring-inset ring-accent-600/10 sm:p-12">
        <div class="flex gap-1 text-accent-600" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" class="h-5 w-5" />)}
        </div>
        <p class="text-xl font-semibold text-brand-950 sm:text-2xl">Wie zufrieden waren Sie mit uns?</p>
        <p class="max-w-md text-sm text-brand-700">
          Ihre ehrliche Meinung hilft uns, unseren Service weiter zu verbessern – in nur wenigen Sekunden.
        </p>
        <a href="/bewertungen/" class="btn-primary mt-1">Jetzt bewerten</a>
      </div>
    </div>
  </section>

  <!-- Angebot / Anfrage-Assistent -->
  <section id="angebot" class="bg-warm-50 py-16 sm:py-20 lg:py-24">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-start">
      <div class="reveal">
        <p class="eyebrow">In 60 Sekunden zum Angebot</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Jetzt unverbindlich anfragen</h2>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Beantworten Sie ein paar kurze Fragen – wir melden uns zeitnah mit einem passenden,
          unverbindlichen Angebot bei Ihnen. Ganz ohne Verpflichtung.
        </p>
        <div class="mt-6 space-y-3 text-sm text-brand-900">
          <p class="flex items-center gap-2"><Icon name="phone" class="h-4 w-4 text-accent-600" /> {site.phoneDisplay}</p>
          <p class="flex items-center gap-2"><Icon name="mail" class="h-4 w-4 text-accent-600" /> {site.email}</p>
        </div>
      </div>
      <QuoteWizard services={allServiceTitles} />
    </div>
  </section>
</Layout>
