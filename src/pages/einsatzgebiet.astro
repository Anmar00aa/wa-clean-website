---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import Icon from "../components/Icon.astro";

const orte = [
  {
    name: "Wiesbaden",
    badge: "Hauptniederlassung",
    manager: "Wael Alsaad",
    text: "In Wiesbaden liegt unsere Hauptniederlassung. Als hessische Landeshauptstadt bringt die Stadt eine große Bandbreite an Objekten mit sich – von Büro- und Verwaltungsgebäuden über Praxen bis zu gehobenen Wohnanlagen. Wir übernehmen hier sowohl regelmäßige Unterhaltsreinigung als auch einmalige Grundreinigungen.",
  },
  {
    name: "Mainz",
    text: "In Mainz sind wir vor allem für Unternehmen, Kanzleien und Hausverwaltungen im Einsatz, die Wert auf feste Ansprechpartner und verlässliche Termine legen. Auch Einsätze auf der linksrheinischen Seite sind für uns kein Umweg.",
  },
  {
    name: "Rüdesheim am Rhein",
    text: "Rüdesheim lebt vom Tourismus – entsprechend wichtig ist ein gepflegtes Erscheinungsbild für Gastronomie, Pensionen und Geschäfte. Wir unterstützen Betriebe hier auch kurzfristig in stärker frequentierten Zeiten.",
  },
  {
    name: "Geisenheim",
    text: "In Geisenheim reinigen wir für Unternehmen, Bildungseinrichtungen und Privathaushalte gleichermaßen. Die Nähe zur Hochschule Geisenheim bringt auch Anfragen aus dem Bildungs- und Forschungsumfeld mit sich.",
  },
  {
    name: "Oestrich-Winkel",
    badge: "Standort Rheingau",
    manager: "Anmar Alemarah",
    text: "In Oestrich-Winkel betreiben wir unseren zweiten Standort mitten im Rheingau. Von hier aus betreuen wir sowohl Gewerbeobjekte als auch Privathaushalte in der Region mit kurzen Anfahrtswegen und flexiblen Terminen.",
  },
  {
    name: "Eltville am Rhein",
    text: "Als „Rosenstadt“ und Weinbauort hat Eltville viele historische Gebäude und gepflegte Anlagen. Wir berücksichtigen bei der Reinigung die besonderen Anforderungen älterer Bausubstanz ebenso wie moderner Neubauten.",
  },
];
---

<Layout
  title="Einsatzgebiet"
  description="Gebäudereinigung im Rheingau, in Wiesbaden, Mainz, Rüdesheim am Rhein, Geisenheim, Oestrich-Winkel und Eltville am Rhein. Regional verwurzelt, zuverlässig im Einsatz."
>
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Einsatzgebiet", href: "/einsatzgebiet/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Einsatzgebiet</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Zu Hause im Rheingau</h1>
        <p class="mt-6 text-brand-700 leading-relaxed">
          Mit unserer Hauptniederlassung in Wiesbaden und einem zweiten Standort in Oestrich-Winkel sind wir
          direkt im Rheingau und in der Landeshauptstadt vertreten. Durch die zentrale Lage sind kurze
          Anfahrtswege und flexible Termine auch kurzfristig möglich.
        </p>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Objekte außerhalb der unten genannten Orte übernehmen wir gerne nach Anfrage – sprechen Sie uns
          einfach auf Ihren Standort an.
        </p>
      </div>
      <PhotoPlaceholder class="reveal aspect-[4/3] w-full" label="Karte: Einsatzgebiet Rheingau" variant="dark" />
    </div>
  </section>

  <section class="bg-warm-50 py-14 sm:py-16">
    <div class="container-page">
      <h2 class="reveal text-2xl font-semibold sm:text-3xl">Unsere Orte im Überblick</h2>
      <div class="reveal-group mt-8 grid gap-5 sm:grid-cols-2">
        {orte.map((ort) => (
          <div class="reveal-item card p-6">
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-50 text-brand-950">
                <Icon name="map-pin" class="h-4 w-4" />
              </span>
              <h3 class="text-lg font-semibold text-brand-950">{ort.name}</h3>
              {ort.badge && (
                <span class="rounded-full bg-accent-100 px-2.5 py-1 text-xs font-medium text-accent-700">
                  {ort.badge}
                </span>
              )}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-brand-700">{ort.text}</p>
            {ort.manager && <p class="mt-3 text-xs text-brand-600">Ansprechpartner: {ort.manager}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container-page flex flex-col items-center gap-5 text-center">
      <h2 class="text-2xl font-semibold sm:text-3xl">Ihr Standort ist nicht dabei?</h2>
      <p class="max-w-xl text-brand-700">
        Fragen Sie unverbindlich an – wir prüfen gerne, ob wir auch Ihr Objekt außerhalb des Rheingaus
        übernehmen können.
      </p>
      <a href="/kontakt/" class="btn-primary">Kostenloses Angebot anfordern</a>
    </div>
  </section>
</Layout>
