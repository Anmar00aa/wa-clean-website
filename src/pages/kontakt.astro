---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import SiteVisitForm from "../components/SiteVisitForm.astro";
import CallbackForm from "../components/CallbackForm.astro";
import Icon from "../components/Icon.astro";
import { site, locations } from "../config/site";

const allServiceTitles = (await getCollection("leistungen"))
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge)
  .map((s) => s.data.title);
---

<Layout
  title="Kontakt & Angebot"
  description="Kontaktieren Sie uns für ein kostenloses, unverbindliches Angebot zur Gebäudereinigung im Rheingau und in Wiesbaden. Telefonisch, per E-Mail oder über das Kontaktformular."
>
  <Breadcrumbs items={[{ label: "Startseite", href: "/" }, { label: "Kontakt", href: "/kontakt/" }]} />

  <section class="py-14 sm:py-16">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start">
      <div class="reveal">
        <p class="eyebrow">Kontakt</p>
        <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Kostenloses Angebot anfordern</h1>
        <p class="mt-4 text-brand-700 leading-relaxed">
          Ob per Telefon, E-Mail oder Formular – wir melden uns zeitnah bei Ihnen mit einem unverbindlichen
          Angebot, das zu Ihrem Gebäude passt.
        </p>

        <ul class="reveal-group mt-8 space-y-4 text-sm">
          <li class="reveal-item flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-950">
              <Icon name="mail" class="h-4.5 w-4.5" />
            </span>
            <div>
              <p class="font-semibold text-brand-950">E-Mail</p>
              <a href={`mailto:${site.email}`} class="block text-brand-700 hover:text-accent-600">{site.email}</a>
              <a href={`mailto:${site.emailService}`} class="block text-brand-700 hover:text-accent-600">{site.emailService}</a>
            </div>
          </li>
          <li class="reveal-item flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-950">
              <Icon name="clock" class="h-4.5 w-4.5" />
            </span>
            <div>
              <p class="font-semibold text-brand-950">Erreichbarkeit</p>
              <p class="text-brand-700">{site.openingHours}</p>
            </div>
          </li>
        </ul>

        <div class="reveal-group mt-8 grid gap-4 sm:grid-cols-2">
          {locations.map((loc) => (
            <div class="reveal-item card p-5">
              <div class="flex items-center gap-2">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-950">
                  <Icon name="map-pin" class="h-4 w-4" />
                </span>
                <p class="text-sm font-semibold text-brand-950">{loc.label}</p>
              </div>
              <p class="mt-3 text-sm text-brand-700">{loc.street}<br />{loc.zip} {loc.city}</p>
              <p class="mt-2 text-xs text-brand-600">Ansprechpartner: {loc.manager}</p>
              <div class="mt-3 space-y-1 text-sm">
                <a href={loc.phoneHref} class="flex items-center gap-1.5 text-brand-700 hover:text-accent-600">
                  <Icon name="phone" class="h-3.5 w-3.5" />
                  {loc.phoneDisplay}
                </a>
                <a href={loc.mobileHref} class="flex items-center gap-1.5 text-brand-700 hover:text-accent-600">
                  <Icon name="phone" class="h-3.5 w-3.5" />
                  {loc.mobileDisplay} <span class="text-xs text-brand-600">(mobil)</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <ContactForm services={allServiceTitles} />
        <p class="mt-4 flex flex-col items-center gap-1 text-center text-sm text-brand-700 sm:flex-row sm:justify-center sm:gap-2">
          <span>Oder direkt telefonisch:</span>
          <span class="flex flex-col items-center gap-1 sm:flex-row sm:gap-2">
            <a href={locations[0].phoneHref} class="font-medium text-brand-950 hover:text-accent-600">
              Wiesbaden {locations[0].phoneDisplay}
            </a>
            <span class="hidden sm:inline">·</span>
            <a href={locations[1].phoneHref} class="font-medium text-brand-950 hover:text-accent-600">
              Rheingau {locations[1].phoneDisplay}
            </a>
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- Besichtigung & Rückruf -->
  <section id="besichtigung" class="scroll-mt-24 bg-warm-50 py-14 sm:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">Für größere Objekte</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Kostenlose Objektbesichtigung anfragen</h2>
        <p class="mt-3 text-sm text-brand-700">
          Besonders bei größeren oder regelmäßig zu reinigenden Objekten schauen wir uns Ihr Gebäude gerne
          persönlich an, um ein passgenaues Angebot zu erstellen.
        </p>
        <div class="mt-5">
          <SiteVisitForm services={allServiceTitles} />
        </div>
      </div>
      <div class="reveal">
        <p class="eyebrow">Lieber persönlich sprechen?</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">Kostenlosen Rückruf anfordern</h2>
        <p class="mt-3 text-sm text-brand-700">
          Hinterlassen Sie kurz Ihre Nummer und die bevorzugte Erreichbarkeit – wir rufen Sie gerne zurück.
        </p>
        <div class="mt-5">
          <CallbackForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
